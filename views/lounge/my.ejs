<%- include('_top') %>
<section class="lg-wrap lg-pagehead">
  <p class="lg-kicker">My</p>
  <h1 class="lg-h1"><%= nick %>님의 라운지</h1>
  <p class="lg-muted"><%= user.interest ? '관심: ' + user.interest + ' · ' : '' %>가입 <%= new Date(acct.created_at).toLocaleDateString('ko-KR', { timeZone: 'Asia/Seoul' }) %></p>
  <div class="lg-pagehead-actions">
    <a href="/onboard?edit=1" class="lg-btn sm">프로필 바꾸기</a>
    <form method="post" action="/logout" class="inline"><button class="lg-btn sm ghost">로그아웃</button></form>
  </div>
</section>

<%
  const fd = (d) => { if (!d) return ''; const x = new Date(d); return x.getUTCFullYear() + '.' + (x.getUTCMonth() + 1) + '.' + x.getUTCDate(); };
  const act = enrolls.filter(function(e){ return e.is_active; });
  const past = enrolls.filter(function(e){ return !e.is_active; });
%>
<section class="lg-wrap lg-sec">
  <% if (act.length) { %>
    <div class="lg-stu">
      <% act.forEach(function(e){ %>
        <div class="lg-card lg-stu-card">
          <div class="lg-stu-h">
            <span class="lg-stu-badge"><%= e.ptype === 'ebook' ? '📖 내 전자책' : '🎓 수강 중' %></span>
            <h2 class="lg-h3"><%= e.product_title %></h2>
            <p class="lg-muted"><%= fd(e.starts_s) %> ~ <%= e.ends_s ? fd(e.ends_s) + ' · ' + (e.days_left === 0 ? '오늘 마지막 날' : e.days_left + '일 남음') : (e.ptype === 'ebook' ? '계속 다시 보기' : '평생') %><%= e.kind ? ' · ' + e.kind : '' %></p>
          </div>
          <% if (e.student_note) { %><p class="lg-stu-note"><%= e.student_note %></p><% } %>
          <div class="lg-stu-links">
            <% e.links.forEach(function(l, i){ %>
              <a href="<%= l.url %>"<%- /^https?:/.test(l.url) ? ' target="_blank" rel="noopener"' : '' %> class="lg-btn <%= i === 0 ? 'primary' : '' %>"><%= l.label %> →</a>
            <% }); %>
            <a href="/consult?type=course" class="lg-btn ghost"><%= e.ptype === 'ebook' ? '문의하기' : '수강 문의' %></a>
          </div>
        </div>
      <% }); %>
      <% if (stuRes.length) { %>
        <div class="lg-card">
          <h2 class="lg-h3">📚 수강생 전용 자료</h2>
          <ul class="lg-list">
            <% stuRes.forEach(function(r){ %><li><a href="/library/<%= r.id %>"><%= r.title %></a> <span class="lg-muted">· <%= r.section %></span></li><% }); %>
          </ul>
        </div>
      <% } %>
      <% if (upsell) { %>
        <a href="/course#plans" class="lg-builderbar">
          <span>🙋</span>
          <div><b>혼자 하다 막히면, 1:1 피드백 과정으로</b><small>전자책 금액 <%= L.won(upsell) %>을 전액 차감해 드려요 · 고객 모집·스레드 운영까지 같이</small></div>
          <em>과정 보기 →</em>
        </a>
      <% } %>
      <p class="lg-hint">수강생과 전자책 구매자는 자료실의 💎 포인트 자료집도 포인트 없이 바로 열 수 있어요.</p>
    </div>
  <% } else { %>
    <div class="lg-card lg-stu-none">
      <div><b>🎓 수강 중인 과정이 없어요</b><p class="lg-muted">강의나 전자책을 결제하시면 여기에 뜨고, 자료와 도구로 바로 들어갈 수 있어요. 현금으로 결제하셨다면 확인 후 열어 드려요.</p></div>
      <a href="/course" class="lg-btn primary sm">수강 신청 보기</a>
    </div>
  <% } %>
  <% if (past.length) { %>
    <details class="lg-stu-past">
      <summary>지난 수강 <%= past.length %>개</summary>
      <ul class="lg-list">
        <% past.forEach(function(e){ %><li><%= e.product_title %> <span class="lg-muted">· <%= fd(e.starts_s) %> ~ <%= e.ends_s ? fd(e.ends_s) : '평생' %> · <%= e.status === 'refunded' ? '환불' : '종료' %></span></li><% }); %>
      </ul>
    </details>
  <% } %>
</section>

<section class="lg-wrap lg-sec lg-mygrid">
  <div class="lg-card lg-mypoints" id="points">
    <h2 class="lg-h3">💎 내 포인트</h2>
    <p class="lg-mypoints-bal"><b><%= P.fmt(pt.balance) %></b>P</p>
    <p class="lg-muted">오늘 글 <%= Math.min(pt.today.posts, pt.rules.postDaily) %>/<%= pt.rules.postDaily %> (+<%= pt.rules.post %>P씩) · 후기 <%= Math.min(pt.today.reviews, pt.rules.reviewDaily) %>/<%= pt.rules.reviewDaily %> (+<%= pt.rules.review %>P)</p>
    <div class="lg-bbtns">
      <a href="/community?cat=proof&write=1#write" class="lg-btn sm">글 쓰고 모으기</a>
      <a href="/reviews?write=1#write" class="lg-btn sm">후기 쓰고 모으기</a>
      <a href="/library" class="lg-btn sm primary">자료집 열기</a>
    </div>
    <% if (hist.length) { %>
      <ul class="lg-pthist">
        <% hist.forEach(function(h){ %>
          <li><span><%= h.label %></span><small><%= L.ago(h.created_at) %></small><b class="<%= h.amount < 0 ? 'minus' : 'plus' %>"><%= h.amount > 0 ? '+' : '' %><%= P.fmt(h.amount) %>P</b></li>
        <% }); %>
      </ul>
    <% } else { %>
      <p class="lg-muted">아직 기록이 없어요. 가입 인사부터 남겨 보세요!</p>
    <% } %>
  </div>

  <div class="lg-card">
    <h2 class="lg-h3">🛠 블로그 대행 도구</h2>
    <% if (acct.status === 'active') { %>
      <p class="lg-muted">수강생 도구를 쓰실 수 있어요.</p>
      <a href="/hub" class="lg-btn primary block">도구 열기</a>
    <% } else if (acct.status === 'suspended') { %>
      <p class="lg-muted">도구 이용이 중지된 계정이에요. 1:1 상담으로 문의해 주세요.</p>
    <% } else if (acct.referred_by) { %>
      <p class="lg-muted">⏳ 도구 이용 승인을 기다리고 있어요.</p>
    <% } else { %>
      <p class="lg-muted">바이란 수강생이시면 추천인 코드를 넣고 도구 이용을 신청해 주세요.</p>
      <a href="/welcome" class="lg-btn block">추천인 코드 넣기</a>
    <% } %>
  </div>

  <div class="lg-card" id="box">
    <h2 class="lg-h3">📚 내가 본 자료</h2>
    <% if (opened.length) { %>
      <ul class="lg-list">
        <% opened.forEach(function(r){ %><li><a href="/library/<%= r.id %>"><%= r.title %></a> <span class="lg-muted">· <%= r.section %></span></li><% }); %>
      </ul>
    <% } else { %>
      <p class="lg-muted">아직 연 자료가 없어요. <a href="/library">자료실</a>에서 무료 자료집부터 챙겨 가세요.</p>
    <% } %>
  </div>

  <div class="lg-card">
    <h2 class="lg-h3">♡ 즐겨찾기한 프롬프트</h2>
    <% if (favs.length) { %>
      <div class="lg-pgrid tiny">
        <% favs.forEach(function(p){ %>
          <a href="/prompts/<%= p.id %>" class="lg-pcard">
            <div class="lg-pcard-img"><% if (p.image_ids.length) { %><img src="/u/img/<%= p.image_ids[0] %>" alt="<%= p.title %>" loading="lazy"><% } else { %><div class="lg-pcard-noimg">TEXT</div><% } %></div>
            <b><%= p.title %></b>
          </a>
        <% }); %>
      </div>
    <% } else { %>
      <p class="lg-muted">마음에 드는 프롬프트에서 ♡를 누르면 여기에 모여요.</p>
    <% } %>
  </div>

  <div class="lg-card">
    <h2 class="lg-h3">✍️ 내가 쓴 글</h2>
    <% if (posts.length) { %>
      <ul class="lg-list">
        <% posts.forEach(function(p){ %><li><a href="/community/<%= p.id %>"><%= p.title %></a> <span class="lg-muted">· <%= L.ago(p.created_at) %></span></li><% }); %>
      </ul>
    <% } else { %>
      <p class="lg-muted">아직 쓴 글이 없어요. <a href="/community?cat=proof&write=1#write">오늘의 인증</a>부터 남겨 볼까요?</p>
    <% } %>
  </div>

  <div class="lg-card">
    <h2 class="lg-h3">⭐ 내 후기</h2>
    <% if (myReviews.length) { %>
      <ul class="lg-list">
        <% myReviews.forEach(function(r){ %>
          <li><span class="lg-tag <%= r.status === 'approved' ? 'ok' : r.status === 'rejected' ? 'warn' : '' %>"><%= { approved: '올라감', pending: '확인 중', rejected: '반려' }[r.status] %></span> <%= r.product || '무료 자료집·라운지' %> <span class="lg-muted">· <%= r.body.slice(0, 30) %>…</span></li>
        <% }); %>
      </ul>
    <% } else { %>
      <p class="lg-muted">자료집이나 강의가 도움이 됐다면 <a href="/reviews?write=1#write">후기</a>를 남겨 주세요.</p>
    <% } %>
  </div>

  <div class="lg-card">
    <h2 class="lg-h3">🏆 성과 올리기</h2>
    <p class="lg-muted">첫 수익, 첫 문의, 팔로워 100명… 작은 것도 좋아요. 다른 분들께 큰 힘이 돼요.</p>
    <button type="button" class="lg-btn block" data-open="resultModal">＋ 성과 인증샷 올리기</button>
  </div>
</section>
<%- include('_bottom') %>
