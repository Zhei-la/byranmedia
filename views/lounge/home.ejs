<%- include('_top') %>
<%
  const heroLines = String(S.hero_title || '').split('\n');
  const kakaoStart = '/login?next=/';
  const SOONH = typeof soon !== 'undefined' && soon ? soon : {};
  const PEEK = user && user.role === 'admin';
  const peekTag = '<span class="lg-peek">🔒 준비중 · 운영자에게만 보여요</span>';
  const SEC_ICON = { '수강 안내': '🎓', '사주·타로': '🔮', '쿠팡파트너스': '🛒', '스레드 글쓰기': '✍️', 'AI 이미지': '🎨', '무료 자료': '🎁' };
%>

<% if (!user) { %>
  <section class="lg-hero">
    <div class="lg-wrap lg-hero-grid">
      <div class="lg-hero-copy">
        <p class="lg-kicker">바이란 라운지 · AI로 시작하는 1인 창업</p>
        <h1 class="lg-display">
          <% heroLines.forEach(function(line, i){ %><%= line %><% if (i < heroLines.length - 1) { %><br><% } %><% }); %>
        </h1>
        <p class="lg-hero-sub"><%- L.esc(S.hero_sub).replace(/\n/g, '<br>') %></p>
        <div class="lg-hero-cta">
          <a href="<%= kakaoStart %>" class="lg-btn kakao lg">
            <svg width="18" height="17" viewBox="0 0 18 17" aria-hidden="true"><path d="M9 0C4.03 0 0 3.13 0 6.99c0 2.5 1.68 4.69 4.2 5.92l-1.06 3.9c-.09.34.29.61.59.42l4.66-3.07c.2.02.4.02.61.02 4.97 0 9-3.13 9-6.99C18 3.13 13.97 0 9 0z" fill="currentColor"/></svg>
            카카오로 3초 시작
          </a>
          <a href="/prompts" class="lg-btn ghost lg">AI 프롬프트 구경하기 →</a>
        </div>
        <% if (!SOONH.library) { %><p class="lg-hero-note"><%= S.welcome_note %></p><% } %>
      </div>
      <div class="lg-hero-card" aria-label="라운지에서 받을 수 있는 것">
        <div class="lg-byline"><span>BY</span> 바이란 라운지</div>
        <ol class="lg-howto">
          <% if (SOONH.library) { %>
          <li><b>AI 프롬프트</b><span>이미지 누르고 바로 복사, 생성기까지</span></li>
          <li><b>프롬프트 요청</b><span>원하는 컨셉을 남기면 프롬프트로 만들어 올려 드려요</span></li>
          <li><b>같이 크는 곳</b><span>질문하고, 인증하고, 같이 묻고 답해요</span></li>
          <% } else { %>
          <li><b>무료 자료집</b><span>쿠팡파트너스는 가입 즉시, 사주·타로·스레드는 포인트로</span></li>
          <li><b>AI 프롬프트</b><span>이미지 누르고 바로 복사, 생성기까지</span></li>
          <li><b>같이 크는 곳</b><span>글 +<%= S.pt_post %>P, 후기 +<%= S.pt_review %>P — 모아서 자료집 열기</span></li>
          <% } %>
        </ol>
      </div>
    </div>
  </section>
<% } else { %>
  <section class="lg-wrap lg-greet">
    <div class="lg-greet-card">
      <div class="lg-greet-l">
        <p class="lg-kicker"><%= nick %>님</p>
        <h1 class="lg-h1">오늘은 뭐부터 해볼까요?</h1>
        <p class="lg-muted">자료집 보고, 프롬프트 복사하고, 막히면 커뮤니티에 물어보세요.</p>
      </div>
      <div class="lg-quick">
        <% if (SOONH.library) { %><a href="/community?cat=request&write=1#write"><span>💡</span><b>프롬프트 요청</b><small>원하는 컨셉 남기기</small></a><% } else { %><a href="/library"><span>📚</span><b>자료실</b><small>무료 자료집</small></a><% } %>
        <a href="/prompts"><span>🎨</span><b>AI 프롬프트</b><small>복사해서 바로</small></a>
        <a href="/prompts/builder"><span>🪄</span><b>프롬프트 생성기</b><small>칸만 채우면 완성</small></a>
        <a href="/community?cat=proof&write=1#write"><span>✅</span><b>인증하기</b><small>오늘 한 것 남기기</small></a>
      </div>
    </div>
  </section>
<% } %>

<!-- 프롬프트 -->
<% if (prompts.length) { %>
<section class="lg-wrap lg-sec">
  <div class="lg-sec-h">
    <div><p class="lg-kicker">AI Prompts</p><h2 class="lg-h2">이미지 누르면 프롬프트가 나와요</h2></div>
    <a href="/prompts" class="lg-more">프롬프트 전체 →</a>
  </div>
  <div class="lg-pgrid mini">
    <% prompts.forEach(function(p){ %>
      <a href="/prompts/<%= p.id %>" class="lg-pcard">
        <div class="lg-pcard-img"><img src="/u/img/<%= p.image_ids[0] %>" alt="<%= p.title %>" loading="lazy"><% if (p.image_ids.length > 1) { %><span class="n">▣ <%= p.image_ids.length %></span><% } %></div>
        <b><%= p.title %></b>
      </a>
    <% }); %>
  </div>
  <a href="/prompts/builder" class="lg-builderbar">
    <span>🪄</span>
    <div><b>프롬프트 생성기로 나만의 프롬프트 만들기</b><small>인물·화보·제품 패턴에 칸만 채우면 영어 프롬프트가 완성돼요</small></div>
    <em>열기 →</em>
  </a>
  <a href="/community?cat=request" class="lg-builderbar req">
    <span>💡</span>
    <div><b>원하는 프롬프트 요청하기</b><small>컨셉만 적어 주시면 프롬프트로 만들어 올려 드려요</small></div>
    <em>요청 →</em>
  </a>
</section>
<% } %>

<!-- 자료실 (준비중이면 운영자만 보임) -->
<% if (sections.length && !SOONH.library) { %>
<section class="lg-wrap lg-sec">
  <div class="lg-sec-h">
    <div><p class="lg-kicker">Library<% if (PEEK && S.soon_library === '1') { %> <%- peekTag %><% } %></p><h2 class="lg-h2"><%= user ? '자료실' : '가입하면 바로 보는 무료 자료집' %></h2></div>
    <a href="/library" class="lg-more">자료실 전체 →</a>
  </div>
  <div class="lg-secgrid">
    <% sections.forEach(function(s, si){ %>
      <a href="/library?s=<%= encodeURIComponent(s.section) %>#sec" class="lg-seccard tint-<%= si % 5 + 1 %>">
        <span class="i"><%= SEC_ICON[s.section] || '📁' %></span>
        <b><%= s.section %></b>
        <% if (SOONH.library) { %><small><i class="lg-soonchip">준비중</i> 곧 열려요</small><% } else { %>
        <small><%= s.n %>개 자료<%= s.has_points ? ' · 💎 포인트로 열기' : '' %><%= s.has_code ? ' · 🔒 라이브 전용 포함' : '' %></small>
        <% } %>
      </a>
    <% }); %>
    <% if (!SOONH.course) { %>
    <a href="/library#course" class="lg-seccard tint-5">
      <span class="i">🎓</span><b>수강 · 전자책</b><small>혼자 하기 · 1:1 피드백</small>
    </a>
    <% } %>
    <a href="<%= SOONH.library ? '/agency' : '/library#agency' %>" class="lg-seccard tint-4">
      <span class="i">💼</span><b>대행 문의</b><small>스레드 · 블로그 운영 대행</small>
    </a>
  </div>
</section>
<% } %>

<% if (cohort) { %>
  <section class="lg-wrap lg-sec">
    <a href="/challenge" class="lg-banner">
      <div>
        <p class="lg-kicker light"><%= cohort.status === 'recruiting' ? '모집 중' : '진행 중' %> · <%= cohort.name %></p>
        <h2><%= cohort.title %></h2>
        <p><%= cohort.days %>일 동안 매일 미션 하나. 같은 기수와 끝까지 가요.</p>
      </div>
      <span class="lg-btn light">자세히 보기 →</span>
    </a>
  </section>
<% } %>

<!-- 성과 -->
<% if (results.length) { %>
<section class="lg-wrap lg-sec">
  <div class="lg-sec-h">
    <div><p class="lg-kicker">Real Results</p><h2 class="lg-h2">회원들이 직접 올린 성과</h2></div>
    <% if (user && me) { %><button type="button" class="lg-btn sm" data-open="resultModal">＋ 성과 올리기</button><% } %>
  </div>
  <div class="lg-wall">
    <% results.forEach(function(r){ var k = L.RESULT_KINDS[r.kind] || L.RESULT_KINDS.income; %>
      <figure class="lg-shot">
        <% if (r.image_id) { %><img src="/u/img/<%= r.image_id %>" alt="<%= r.headline %> 인증 사진" loading="lazy"><% } %>
        <figcaption><span class="k"><%= k.icon %> <%= k.label %></span><b><%= r.headline %></b><small><%= r.nick %><%= r.channel ? ' · ' + r.channel : '' %></small></figcaption>
      </figure>
    <% }); %>
  </div>
</section>
<% } %>

<!-- 채팅 + 게시판 -->
<section class="lg-wrap lg-sec lg-two">
  <div class="lg-card lg-chat" data-chat data-after="<%= chat.length ? chat[chat.length-1].id : 0 %>" data-login="<%= user && me ? '1' : '' %>">
    <div class="lg-card-h">
      <h3># 실시간 수다방</h3>
      <span class="lg-live"><i></i> <span data-online>지금</span></span>
    </div>
    <ul class="lg-chat-list" data-list>
      <% chat.forEach(function(m){ %>
        <li><b class="<%= m.role === 'admin' ? 'admin' : '' %>"><%= m.nick %></b><span><%= m.body %></span></li>
      <% }); %>
      <% if (!chat.length) { %><li class="lg-muted" data-emptyrow>아직 조용해요. 첫 인사를 남겨 주세요!</li><% } %>
    </ul>
    <% if (user && me) { %>
      <form class="lg-chat-form" data-chatform>
        <input name="body" maxlength="300" placeholder="메시지 보내기" autocomplete="off" aria-label="채팅 메시지">
        <button class="lg-btn primary sm">전송</button>
      </form>
    <% } else { %>
      <a href="<%= kakaoStart %>" class="lg-chat-lock">🔒 가입하면 같이 이야기할 수 있어요</a>
    <% } %>
  </div>

  <div class="lg-card flush">
    <div class="lg-card-h pad">
      <h3>라운지 게시판</h3>
      <a href="/community" class="lg-more">전체 →</a>
    </div>
    <% if (board.length) { %>
      <ul class="lg-board">
        <% board.forEach(function(p){ var c = L.CATEGORIES[p.category] || {label:'자유'}; %>
          <li class="<%= p.category === 'notice' ? 'notice' : '' %>">
            <a href="/community/<%= p.id %>">
              <span class="lg-cat c-<%= p.category %>"><%= c.label %></span>
              <span class="t"><%= p.category === 'secret' ? '🔒 비밀글입니다' : p.title %><% if (p.comments) { %> <em>[<%= p.comments %>]</em><% } %></span>
              <span class="m"><%= p.nick %> · <%= L.ago(p.created_at) %></span>
            </a>
          </li>
        <% }); %>
      </ul>
    <% } else { %>
      <div class="lg-empty"><p>첫 글을 기다리고 있어요. 가입 인사부터 남겨 주세요!</p></div>
    <% } %>
  </div>
</section>

<% if (courses.length && !SOONH.course) { %>
<section class="lg-wrap lg-sec">
  <div class="lg-sec-h">
    <div><p class="lg-kicker">E-book · 1:1 Feedback<% if (PEEK && S.soon_course === '1') { %> <%- peekTag %><% } %></p><h2 class="lg-h2">혼자 해볼지, 같이 갈지</h2></div>
    <a href="/library#course" class="lg-more">수강 · 전자책 →</a>
  </div>
  <div class="lg-courses mini">
    <% courses.forEach(function(c){ %>
      <a href="/course#<%= c.ptype === 'ebook' ? 'ebook' : 'c' + c.id %>" class="lg-course">
        <% if (c.badge) { %><span class="lg-badge"><%= c.badge %></span><% } %>
        <b><%= c.title %></b>
        <% if (c.subtitle) { %><p><%= c.subtitle %></p><% } %>
        <% if (c.price_text) { %><span class="lg-price"><% if (c.list_price) { %><s class="lg-list-s"><%= c.list_price %></s> <% } %><%= c.price_text %></span><% } %>
        <% if (c.price_note) { %><small class="lg-price-note"><%= c.price_note %></small><% } %>
      </a>
    <% }); %>
  </div>
</section>
<% } %>

<% if (reviews.length) { %>
  <section class="lg-wrap lg-sec">
    <div class="lg-sec-h">
      <div><p class="lg-kicker">Reviews</p><h2 class="lg-h2">직접 해 본 사람들의 이야기</h2></div>
      <a href="/reviews" class="lg-more">후기 전체 →</a>
    </div>
    <div class="lg-reviews">
      <% reviews.forEach(function(r){ %>
        <blockquote class="lg-review">
          <div class="stars" aria-label="별점 <%= r.rating %>점"><%= '★'.repeat(r.rating) %><span><%= '★'.repeat(5 - r.rating) %></span></div>
          <p><%= r.body.length > 140 ? r.body.slice(0, 140) + '…' : r.body %></p>
          <footer><b><%= r.nick %></b><%= r.industry ? ' · ' + r.industry : '' %><% if (r.product) { %><span class="lg-tag"><%= r.product %></span><% } %></footer>
        </blockquote>
      <% }); %>
    </div>
  </section>
<% } %>

<% if (!SOONH.consult) { %>
<section class="lg-wrap lg-sec">
  <div class="lg-consult-box">
    <div>
      <p class="lg-kicker">1:1 무료 상담<% if (PEEK && S.soon_consult === '1') { %> <%- peekTag %><% } %></p>
      <h2 class="lg-h2">어떤 상황이세요?</h2>
      <p class="lg-muted">상황을 골라 남겨 주시면 바이란이 직접 연락드려요.</p>
    </div>
    <div class="lg-consult-opts">
      <a href="/consult?type=start" class="lg-opt"><b>이제 시작하고 싶어요</b><span>AI 부업, 뭐부터 할지 →</span></a>
      <a href="/consult?type=grow" class="lg-opt"><b>하고 있는데 매출을 올리고 싶어요</b><span>1:1 컨설팅 · 대행 문의 →</span></a>
    </div>
  </div>
</section>
<% } %>

<% if (!user) { %>
  <section class="lg-wrap lg-sec">
    <div class="lg-final">
      <h2 class="lg-display sm"><% if (SOONH.library) { %>가입하고<br>원하는 프롬프트를 요청해 보세요<% } else { %>가입하면<br>쿠팡파트너스 자료집부터 바로<% } %></h2>
      <a href="<%= kakaoStart %>" class="lg-btn kakao lg">카카오로 3초 시작</a>
    </div>
  </section>
<% } %>

<%- include('_bottom') %>
