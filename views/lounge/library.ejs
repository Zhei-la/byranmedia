<%- include('_top') %>
<%
  const KIND = { pdf: 'PDF', video: '강의', link: '자료집', text: '읽을거리' };
  const SEC_ICON = { '수강 안내': '🎓', '사주·타로': '🔮', '쿠팡파트너스': '🛒', '스레드 글쓰기': '✍️', 'AI 이미지': '🎨', '무료 자료': '🎁' };
%>
<section class="lg-wrap lg-pagehead">
  <p class="lg-kicker">Library</p>
  <h1 class="lg-h1">자료실</h1>
  <p class="lg-muted">쿠팡파트너스 자료집은 가입만 하면 바로 볼 수 있어요.<% if (hasPoints) { %> 💎 표시가 있는 자료집은 커뮤니티에 글·후기를 남겨 모은 포인트로 열어요. 포인트는 쓰고 나서 다시 모으면 돼요.<% } %><% if (hasCode) { %> 🎟 표시는 무료 라이브에서 알려드리는 코드로 열려요.<% } %></p>
  <% if (groups.length > 1) { %>
    <nav class="lg-tabs" aria-label="자료 칸">
      <% if (products.length) { %><a href="#course">🎓 수강 · 전자책</a><% } %>
      <a href="#agency">💼 대행 문의</a>
      <% groups.forEach(function(g){ %>
        <a href="#s-<%= encodeURIComponent(g.name) %>" class="<%= sec === g.name ? 'on' : '' %>"><%= SEC_ICON[g.name] || '📁' %> <%= g.name %></a>
      <% }); %>
    </nav>
  <% } %>
</section>

<section class="lg-wrap lg-sec" id="sec">
  <% if (!user) { %>
    <div class="lg-lockcard">
      <span>🔒</span>
      <div><b>자료실은 회원만 볼 수 있어요</b><p>카카오로 3초면 가입돼요. 가입하면 바로 열려요.</p></div>
      <a href="/login?next=/library" class="lg-btn kakao sm">시작하기</a>
    </div>
  <% } else if (!me) { %>
    <div class="lg-lockcard">
      <span>👋</span>
      <div><b>닉네임만 정하면 바로 열려요</b></div>
      <a href="/onboard?next=/library" class="lg-btn primary sm">닉네임 정하기</a>
    </div>
  <% } %>

  <% if (isStu) { %>
    <div class="lg-ptbar"><div class="lg-ptbar-bal"><b>🎓 수강·구매 중이에요</b></div><div class="lg-ptbar-rules"><span>포인트 자료집도 포인트 없이 바로 열려요.</span></div><a href="/my" class="lg-btn sm primary">내 수강 화면 →</a></div>
  <% } else if (hasPoints && me) { %><%- include('_ptbar') %><% } %>

  <% if (hasCode && user && me && !codeOk && user.role !== 'admin') { %>
    <form method="post" action="/library/code" class="lg-codebox">
      <div>
        <b>🎟 라이브 코드가 있으신가요?</b>
        <p><%= S.live_note %></p>
      </div>
      <input name="code" class="lg-in" placeholder="코드 입력" autocomplete="off" required maxlength="40" aria-label="라이브 코드">
      <button class="lg-btn primary">열기</button>
    </form>
  <% } %>

  <% if (products.length) {
       const ebp = products.find(function(p){ return p.ptype === 'ebook'; });
       const credit = ebp ? L.priceNum(ebp.price_text) : 0;
       const hasEb = ebp && mine.includes(ebp.id); %>
    <div class="lg-libgroup" id="course">
      <h2 class="lg-h2"><span>🎓</span> 수강 · 전자책 신청</h2>
      <p class="lg-muted lg-libcourse-lead">무료 자료집이 큰 길이라면, 전자책은 그 길을 하나하나, 1:1 피드백 과정은 고객 모집부터 운영까지 옆에서 같이 가요.</p>
      <div class="lg-libcourse">
        <% products.forEach(function(p){ var isEb = p.ptype === 'ebook'; var own = mine.includes(p.id); var after = !isEb && credit ? L.priceNum(p.price_text) - credit : 0; %>
          <div class="lg-lc <%= isEb ? 'eb' : '' %> <%= p.badge === '추천' ? 'hot' : '' %>">
            <div class="lg-lc-top">
              <span class="lg-gift-k"><%= isEb ? '📖 전자책 · 혼자 하기' : '🎓 ' + (p.kind || '1:1 피드백') %></span>
              <% if (p.badge && !isEb) { %><span class="lg-badge sm"><%= p.badge %></span><% } %>
            </div>
            <h3><%= p.title %></h3>
            <% if (p.subtitle) { %><p><%= p.subtitle %></p><% } %>
            <div class="lg-lc-price">
              <% if (p.list_price) { %><s><%= p.list_price %></s><% } %>
              <b><%= p.price_text || '금액 문의' %></b>
              <% if (p.price_note) { %><small><%= p.price_note %></small><% } %>
            </div>
            <% if (p.dyn && !p.dyn.maxed) { %><p class="lg-dyn">📈 <%= p.dyn.every %>명 구매할 때마다 <%= L.won(p.dyn.step) %>씩 올라요 · 이 가격 <b><%= p.dyn.left %>자리</b> 남음</p><% } %>
            <% if (after > 0) { %><p class="lg-lc-credit <%= hasEb ? 'mine' : '' %>">📖 <%= hasEb ? '전자책 구매하셔서' : '전자책 구매자는' %> <%= L.won(credit) %> 차감 → <b><%= L.won(after) %></b></p><% } %>
            <div class="lg-lc-cta">
              <% if (own) { %>
                <a href="/my" class="lg-btn primary sm"><%= isEb ? '📖 내 전자책 보기' : '🎓 수강 중 · 수강 화면' %></a>
              <% } else { %>
                <a href="/course?pick=<%= p.id %>#apply" class="lg-btn primary sm">신청하기</a>
              <% } %>
              <a href="/course#<%= isEb ? 'ebook' : 'c' + p.id %>" class="lg-btn sm">자세히 보기</a>
            </div>
          </div>
        <% }); %>
      </div>
      <a href="/course" class="lg-builderbar lg-lc-more">
        <span>🧭</span>
        <div><b>무엇이 다른지 한눈에 보기</b><small>단계별 차이 · 다루는 내용 · 비교표 · 자주 묻는 질문 · 신청서</small></div>
        <em>자세히 →</em>
      </a>
    </div>
  <% } %>

  <% if (groups.length) { %>
    <% groups.forEach(function(g, gi){ %>
      <div class="lg-libgroup tint-<%= gi % 5 + 1 %>" id="s-<%= encodeURIComponent(g.name) %>">
        <h2 class="lg-h2"><span><%= SEC_ICON[g.name] || '📁' %></span> <%= g.name %></h2>
        <div class="lg-lib">
          <% g.items.forEach(function(r){ %>
            <div class="lg-libitem <%= r.open ? 'owned' : '' %>" id="r<%= r.id %>">
              <span class="lg-gift-k"><%= KIND[r.kind] || '자료' %><% if (r.access === 'code') { %> · 라이브 전용<% } else if (r.access === 'course') { %> · 🎓 수강생 전용<% } else if (r.access === 'points') { %> · 💎 <%= P.fmt(r.cost) %>P<% } else if (g.name !== '수강 안내') { %> · 가입하면 무료<% } %></span>
              <h3><%= r.title %></h3>
              <% if (r.description) { %><p><%= r.description %></p><% } %>
              <div class="lg-libitem-f">
                <% if (r.open) { %>
                  <span class="lg-tag ok"><%= isStu && (r.access === 'points' || r.access === 'course') ? '수강생 열람' : '열림' %></span>
                  <a href="/library/<%= r.id %>" class="lg-btn primary sm">열어보기</a>
                <% } else if (!user) { %>
                  <span class="lg-cost"><%= r.access === 'code' ? '🔒 라이브 전용' : r.access === 'course' ? '🎓 수강생 전용' : r.access === 'points' ? '💎 ' + P.fmt(r.cost) + 'P' : '회원 무료' %></span>
                  <a href="/login?next=/library" class="lg-btn sm">가입하고 보기</a>
                <% } else if (!me) { %>
                  <a href="/onboard?next=/library" class="lg-btn sm">닉네임 정하고 보기</a>
                <% } else if (r.access === 'course') { %>
                  <span class="lg-cost">🎓 수강생만 볼 수 있어요</span>
                  <a href="/course" class="lg-btn sm">수강 안내 →</a>
                <% } else if (r.access === 'points') { var bal = pt ? pt.balance : 0; %>
                  <span class="lg-cost">💎 <b><%= P.fmt(r.cost) %>P</b></span>
                  <% if (bal >= r.cost) { %>
                    <form method="post" action="/library/<%= r.id %>/buy" class="inline" data-confirm="<%= P.fmt(r.cost) %>P를 써서 「<%= r.title %>」을 열까요? (남는 포인트 <%= P.fmt(bal - r.cost) %>P)">
                      <button class="lg-btn primary sm">포인트로 열기</button>
                    </form>
                  <% } else { %>
                    <a href="/community?write=1#write" class="lg-btn sm" title="글·후기를 남기면 포인트가 쌓여요"><%= P.fmt(r.cost - bal) %>P 더 모으기 →</a>
                  <% } %>
                <% } else if (r.access === 'code') { %>
                  <span class="lg-cost">🔒 <%= r.lock_note || '무료 라이브에서 받아가세요' %></span>
                <% } else { %>
                  <a href="/onboard?next=/library" class="lg-btn sm">닉네임 정하고 보기</a>
                <% } %>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    <% }); %>
  <% } else { %>
    <div class="lg-card lg-empty">
      <b>자료를 준비하고 있어요</b>
      <p>곧 무료 자료집이 올라와요. 조금만 기다려 주세요!</p>
    </div>
  <% } %>

  <div class="lg-libgroup tint-4" id="agency">
    <h2 class="lg-h2"><span>💼</span> 대행 문의</h2>
    <p class="lg-muted lg-libcourse-lead">직접 배우기보다 내 가게·브랜드 계정을 맡기고 싶다면, 운영을 대신 해 드려요.</p>
    <%- include('_agency_cards') %>
  </div>
</section>
<%- include('_bottom') %>
