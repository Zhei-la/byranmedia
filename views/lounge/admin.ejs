<%- include('_top') %>
<%
  const TABS = [['stats','📊 방문·가입'],['home','⚙️ 설정'],['prompts','🎨 프롬프트'],['library','📚 자료실'],['store','🎓 수강 과정'],['students','🎟 수강생'],['board','💬 게시판·신고'],['reviews','⭐ 후기'],['challenge','🔥 챌린지'],['members','👥 회원']];
  const d = (x) => x ? new Date(x).toLocaleDateString('ko-KR', { month: 'numeric', day: 'numeric', timeZone: 'Asia/Seoul' }) : '';
%>
<section class="lg-wrap wide lg-pagehead">
  <p class="lg-kicker">Admin</p>
  <h1 class="lg-h1">라운지 관리</h1>
  <p class="lg-muted">회원 승인·도구·문의는 <a href="/admin">기존 관리 화면</a>에서 해요. · <a href="/hub">🛠 블로그 대행 도구 열기</a></p>
  <div class="lg-acctbar">
    <span>지금 계정: <b><%= user.nickname || user.name %></b> <small class="lg-muted"><%= user.email %></small></span>
    <form method="post" action="/logout" class="inline"><input type="hidden" name="to" value="switch"><button class="lg-btn sm ghost">🔄 다른 계정으로 로그인</button></form>
  </div>
  <div class="lg-adstats">
    <a href="/admin/lounge?tab=stats" class="lg-adstats-link"><span class="today">오늘 방문한 사람 <b><%= brief.v %></b>명</span></a>
    <a href="/admin/lounge?tab=stats" class="lg-adstats-link"><span class="today">오늘 가입 <b><%= brief.j %></b>명</span></a>
    <span>회원 <b><%= counts.members %></b></span>
    <span>이번 주 새 회원 <b><%= counts.new7 %></b></span>
    <span>프롬프트 <b><%= counts.prompts %></b></span>
    <span>글 <b><%= counts.posts %></b></span>
    <span class="<%= counts.pending_reviews ? 'hi' : '' %>">후기 승인 대기 <b><%= counts.pending_reviews %></b></span>
    <span class="<%= counts.reports ? 'hi' : '' %>">신고 <b><%= counts.reports %></b></span>
    <span class="<%= counts.pending_members ? 'hi' : '' %>">챌린지 신청 <b><%= counts.pending_members %></b></span>
  </div>
  <nav class="lg-tabs"><% TABS.forEach(function(t){ %><a href="/admin/lounge?tab=<%= t[0] %>" class="<%= tab === t[0] ? 'on' : '' %>"><%= t[1] %></a><% }); %></nav>
  <% if (msg) { %><div class="lg-alert ok"><%= msg %></div><% } %>
</section>

<section class="lg-wrap wide lg-sec lg-admin">

<% if (tab === 'stats') {
  var X = stats.sum, M = stats.meta;
  var RL = { today: '당일', '7d': '최근 7일', all: '전체' }[range];
  var PL = { today: '어제보다', '7d': '지난 7일보다', all: '' }[range];
  var up = function(a, b){ if (b == null) return ''; var n = a - b; return n > 0 ? '<i class="lg-up">▲ ' + n + '</i>' : n < 0 ? '<i class="lg-down">▼ ' + (-n) + '</i>' : '<i class="lg-same">–</i>'; };
%>
 <form method="get" action="/admin/lounge" class="lg-inlineform lg-qsearch">
    <input type="hidden" name="tab" value="members">
    <input name="s" class="lg-in" placeholder="🔎 가입자 검색 (닉네임 · 카카오 이름 · 전화 · 이메일 · 메모)">
    <button class="lg-btn sm primary">찾기</button>
  </form>
  <nav class="lg-rangetabs">
    <a href="/admin/lounge?tab=stats" class="<%= range === 'today' ? 'on' : '' %>">당일</a>
    <a href="/admin/lounge?tab=stats&r=7d" class="<%= range === '7d' ? 'on' : '' %>">최근 7일</a>
    <a href="/admin/lounge?tab=stats&r=all" class="<%= range === 'all' ? 'on' : '' %>">전체</a>
  </nav>

  <div class="lg-statlist">
    <div class="lg-stat"><small>방문한 사람</small><p><b><%= X.people %></b><span>명</span><%- up(X.people, X.prev && X.prev.people) %></p></div>
    <div class="lg-stat lg-stat-side"><small>총 방문 횟수 <em>들락날락 전부</em></small><p><b><%= X.visits %></b><span>회</span><%- up(X.visits, X.prev && X.prev.visits) %></p>
      <div class="lg-stat-aside"><span>총 방문 인원</span><b><%= X.people %>명</b><small>기기 기준</small><b class="sub"><%= X.ips %>개</b><small>IP 기준</small></div></div>
    <div class="lg-stat"><small>화면을 연 횟수</small><p><b><%= X.views %></b><span>회</span></p></div>
    <div class="lg-stat"><small>가입</small><p><b><%= X.joins %></b><span>명</span><%- up(X.joins, X.joinsPrev) %></p></div>
    <div class="lg-stat"><small>프롬프트 요청</small><p><b><%= X.reqs %></b><span>건</span></p></div>
    <div class="lg-stat"><small>프롬프트 공유</small><p><b><%= X.shares %></b><span>건</span></p></div>
    <div class="lg-stat"><small>인증 글</small><p><b><%= X.proofs %></b><span>건</span></p></div>
    <div class="lg-stat"><small>방문 → 가입</small><p><b><%= X.rate %></b><span>%</span></p></div>
  </div>
  <p class="lg-hint"><b>방문한 사람</b>은 기기(폰·PC 브라우저) 하나당 1명이에요. 같은 폰으로 여러 번 와도 1명, <b>방문 횟수</b>는 30분 넘게 쉬었다가 다시 오면 1번 더 세요. <%= PL ? '▲▼는 ' + PL + ' 늘거나 줄어든 숫자예요.' : '' %> 운영자(나)와 봇은 빼요 — 화면을 열고 <b>실제로 스크롤·터치하거나 몇 초 머문 브라우저만</b> 사람으로 세요. 전체 가입자 <%= M.total_users %>명<% if (M.since) { %> · <%= M.since.replace(/-/g, '.') %>부터 기록<% } %>.
  <br><small>※ 스레드·인스타·카톡 앱 안에서 연 화면은 앱마다 따로 저장돼서, 같은 사람이 다른 앱으로 들어오면 2명으로 셀 수 있어요.</small></p>
  <% if (typeof ownerUrl !== 'undefined') { %>
  <details class="lg-card mt lg-ownerlink">
    <summary>📵 내 폰의 카톡·스레드 앱에서 들어온 것도 빼기</summary>
    <p class="lg-muted">카톡·스레드·인스타 앱 안에서 사이트를 열면 로그인이 안 된 별도 브라우저라 '다른 사람'으로 세져요. 아래 주소를 <b>그 앱 안에서 한 번씩</b> 열면 (예: 카톡 나와의 채팅에 보내고 눌러 보기) 그 브라우저도 운영자 기기로 기억돼 통계에서 빠져요. 남에게 보내지 마세요.</p>
    <div class="lg-copyrow"><input class="lg-input" readonly value="<%= ownerUrl %>" onclick="this.select()"></div>
  </details>
  <% } %>

  <div class="lg-card mt">
    <h2 class="lg-h3">📱 어느 플랫폼에서 들어왔나 <small class="lg-muted"><%= RL %></small></h2>
    <% var totP = stats.platforms.reduce(function(a, x){ return a + x.people; }, 0) || 1; %>
    <% if (stats.platforms.length) { %>
      <div class="lg-tablewrap">
      <table class="lg-daytable lg-plat">
        <thead><tr><th>플랫폼</th><th>방문한 사람</th><th>비율</th><th>방문 횟수</th><th>가입</th></tr></thead>
        <tbody>
          <% stats.platforms.forEach(function(x){ var pct = Math.round(x.people / totP * 1000) / 10; %>
            <tr><td class="left"><b><%= SOURCES[x.src] || x.src %></b></td><td><%= x.people %>명</td>
                <td class="lg-platbar"><span style="width:<%= Math.max(2, pct) %>%"></span><em><%= pct %>%</em></td>
                <td><%= x.visits %>회</td><td><%= x.joins %>명</td></tr>
          <% }); %>
        </tbody>
      </table>
      </div>
    <% } else { %><p class="lg-muted">아직 기록이 없어요.</p><% } %>
    <p class="lg-hint">스레드·인스타·카톡 앱 안에서 연 링크는 앱 이름으로 알아내요. 더 정확히 보려면 링크 끝에 표시를 붙여서 올리세요: <b>byranmedia.com/?from=threads</b> · <b>?from=instagram</b> · <b>?from=kakao</b> · <b>?from=blog</b>. '가입'은 그 플랫폼으로 처음 들어와서 가입한 사람이에요 (오늘부터 기록).</p>
  </div>

  <div class="lg-two mt">
    <div class="lg-card">
      <div class="lg-card-h"><h2 class="lg-h3">📈 날짜별 <small class="lg-muted">최근 14일</small></h2><a href="/admin/lounge/calendar" class="lg-btn sm">📅 전체보기 (달력)</a></div>
      <%- include('_daychart', { rows: chart }) %>
      <p class="lg-hint">막대를 누르면 그날 숫자가 다 나와요. 진한 막대가 오늘이에요.</p>
    </div>
    <div>
      <div class="lg-card">
        <h2 class="lg-h3">들어오기 전 사이트 주소 <small class="lg-muted"><%= RL %></small></h2>
        <% if (stats.refs.length) { %>
          <ul class="lg-refs"><% stats.refs.forEach(function(r){ %><li><span><%= r.host %></span><b><%= r.n %>명</b></li><% }); %></ul>
        <% } else { %><p class="lg-muted">주소가 넘어온 기록이 없어요. (앱 안 브라우저는 주소를 안 넘겨요)</p><% } %>
      </div>
      <div class="lg-card mt">
        <h2 class="lg-h3">처음 들어온 화면 <small class="lg-muted"><%= RL %></small></h2>
        <% if (stats.pages.length) { %>
          <ul class="lg-refs"><% stats.pages.forEach(function(r){ %><li><span><%= r.path %></span><b><%= r.n %>명</b></li><% }); %></ul>
        <% } else { %><p class="lg-muted">아직 기록이 없어요.</p><% } %>
      </div>
      <div class="lg-card mt">
        <h2 class="lg-h3">🌏 나라별 회원</h2>
        <% if (stats.countries.length) { %>
          <ul class="lg-refs"><% stats.countries.forEach(function(c){ %><li><span><%= c.code ? L.countryLabel(c.code) : '아직 안 고름' %></span><b><%= c.n %>명</b></li><% }); %></ul>
        <% } else { %><p class="lg-muted">아직 회원이 없어요.</p><% } %>
      </div>
      <div class="lg-card mt">
        <h2 class="lg-h3">최근 가입</h2>
        <ul class="lg-refs"><% stats.joins.forEach(function(u){ %><li><span><a href="/admin/lounge/members/<%= u.id %>"><%= u.nick %></a><%= u.done ? '' : ' · 프로필 전' %></span><small class="lg-muted"><%= u.at %></small></li><% }); %></ul>
      </div>
    </div>
  </div>
<% } %>

<% if (tab === 'home') { %>
  <form method="post" action="/admin/lounge/settings" class="lg-card lg-adform">
    <h2 class="lg-h3">기본 설정</h2>
    <div class="lg-adgrid">
      <label>1:1 상담 카톡 주소<input name="consult_url" class="lg-in" value="<%= S.consult_url %>"></label>
      <label>💬 AI 정보 공유방 (카톡 오픈채팅) 주소<input name="live_room_url" class="lg-in" value="<%= S.live_room_url %>" placeholder="https://open.kakao.com/..."></label>
      <label>오픈채팅 참여코드<input name="live_room_code" class="lg-in" value="<%= S.live_room_code %>"></label>
      <label>외부 후기 모음 주소 (카페 등)<input name="review_link" class="lg-in" value="<%= S.review_link %>"></label>
      <label>대행 문의 카톡 주소<input name="agency_kakao" class="lg-in" value="<%= S.agency_kakao %>"></label>
    </div>
    <h2 class="lg-h3 mt">🚧 오픈 전 숨김 · 준비중 <small class="lg-muted">자료집·전자책 준비되면 여기 체크만 풀면 다 돌아와요</small></h2>
    <label class="lg-check"><input type="hidden" name="soon_library" value="0"><input type="checkbox" name="soon_library" value="1" <%= S.soon_library === '1' ? 'checked' : '' %>> 자료실 · 자료집 — 누르면 '준비중입니다'만 뜨고 안 들어가요</label>
    <label class="lg-check"><input type="hidden" name="soon_course" value="0"><input type="checkbox" name="soon_course" value="1" <%= S.soon_course === '1' ? 'checked' : '' %>> 수강 · 전자책 — 홈에서 숨기고, 누르면 '준비중입니다'</label>
    <label class="lg-check"><input type="hidden" name="soon_consult" value="0"><input type="checkbox" name="soon_consult" value="1" <%= S.soon_consult === '1' ? 'checked' : '' %>> 1:1 상담 — 누르면 '준비중입니다', 홈 아래 상담 칸도 숨겨요</label>
    <label class="lg-check"><input type="hidden" name="show_tools" value="0"><input type="checkbox" name="show_tools" value="1" <%= S.show_tools === '1' ? 'checked' : '' %>> 마이페이지·상단 메뉴에 '블로그 대행 도구' 보이기 (도구 승인된 회원만)</label>
    <div class="lg-openlist">
      <b>체크를 풀면 다시 보이는 것</b>
      <ul>
        <li><b>자료실</b> → 자료실·자료집 열림, 홈의 자료집 칸·"가입하면 무료 자료집" 문구, 포인트로 자료집 열기, 마이페이지 '내가 본 자료'</li>
        <li><b>수강·전자책</b> → 수강 페이지 열림, 홈의 전자책·1:1 피드백 칸, 마이페이지 '수강 신청 보기'</li>
        <li><b>1:1 상담</b> → 상담 페이지 열림, 홈 아래 상담 칸</li>
        <li><b>셋 다 풀면</b> → 맨 아래 링크(바이란미디어 소개·수강·대행 문의·챌린지·1:1 상담)</li>
        <li><b>블로그 대행 도구</b> → 위 체크를 켜면 마이페이지·메뉴에 다시 나와요</li>
      </ul>
      <small>커뮤니티(채팅·프롬프트 요청·인증 3칸)는 이대로 유지돼요. 운영자(나)는 막혀 있어도 미리 볼 수 있어요.</small>
    </div>
    <h2 class="lg-h3 mt">라이브 전용 자료 코드</h2>
    <div class="lg-adgrid">
      <label>🎟 라이브 코드 (라이브 때 알려줄 단어)<input name="live_code" class="lg-in" value="<%= S.live_code %>" placeholder="예: 타로0930"></label>
      <label>코드 안내 문구<input name="live_note" class="lg-in" value="<%= S.live_note %>"></label>
    </div>
    <p class="lg-hint">코드를 바꾸면 새로 들어오는 사람만 새 코드로 열려요. 이미 연 사람은 로그아웃 전까지 계속 볼 수 있어요.</p>
    <h2 class="lg-h3 mt">💎 포인트</h2>
    <div class="lg-adgrid">
      <label>글 1개 포인트<input name="pt_post" type="number" min="0" class="lg-in" value="<%= S.pt_post %>"></label>
      <label>글 포인트 하루 최대 개수<input name="pt_post_daily" type="number" min="0" class="lg-in" value="<%= S.pt_post_daily %>"></label>
      <label>후기 1개 포인트<input name="pt_review" type="number" min="0" class="lg-in" value="<%= S.pt_review %>"></label>
      <label>후기 포인트 하루 최대 개수<input name="pt_review_daily" type="number" min="0" class="lg-in" value="<%= S.pt_review_daily %>"></label>
    </div>
    <p class="lg-hint">20자보다 짧은 글, 공지·1:1 문의는 포인트가 없어요. 글을 지우거나 숨기면, 후기를 반려하거나 지우면 받은 포인트가 빠져요. 자료마다 필요한 포인트는 [자료실] 탭에서 정해요.</p>
    <h2 class="lg-h3 mt">프롬프트</h2>
    <p class="lg-hint">✨ 바이란 프롬프트(내가 올린 것)는 누구나 가입 없이 복사할 수 있어요. 🙌 모두의 프롬프트(회원이 공유한 것)는 가입한 회원만 전체를 보고 복사할 수 있어요.</p>
    <h2 class="lg-h3 mt">홈 문구</h2>
    <div class="lg-adgrid">
      <label>큰 제목 (줄바꿈 가능)<textarea name="hero_title" class="lg-in" rows="2"><%= S.hero_title %></textarea></label>
      <label>설명<textarea name="hero_sub" class="lg-in" rows="2"><%= S.hero_sub %></textarea></label>
      <label>가입 안내 한 줄<input name="welcome_note" class="lg-in" value="<%= S.welcome_note %>"></label>
      <label>수강 신청 페이지 안내<input name="course_note" class="lg-in" value="<%= S.course_note %>"></label>
      <label>현금 결제 할인 안내<input name="cash_note" class="lg-in" value="<%= S.cash_note %>"></label>
    </div>
    <button class="lg-btn primary">저장</button>
  </form>
<% } %>

<% if (tab === 'prompts') { const e = edit; %>
  <form method="post" action="/admin/lounge/prompts/save" class="lg-card lg-adform" data-multi-image-form id="pform">
    <h2 class="lg-h3"><%= e ? '프롬프트 고치기' : '새 프롬프트 올리기' %></h2>
    <% if (e) { %><input type="hidden" name="id" value="<%= e.id %>"><% } %>
    <div class="lg-adgrid">
      <label>제목 (카드에 보이는 이름)<input name="title" class="lg-in" required maxlength="120" value="<%= e ? e.title : '' %>" placeholder="예: 비 오는 날 카페 창가 셀카"></label>
      <label>카테고리<select name="category" class="lg-in"><% L.PROMPT_CATS.forEach(function(c){ %><option <%= e && e.category === c ? 'selected' : '' %>><%= c %></option><% }); %></select></label>
      <label>만든 도구 (선택)<input name="model" class="lg-in" maxlength="40" value="<%= e ? e.model || '' : '' %>" placeholder="예: 나노바나나, 미드저니 v7"></label>
      <label>한 줄 메모 (선택)<input name="note" class="lg-in" maxlength="300" value="<%= e ? e.note || '' : '' %>" placeholder="예: 인물 얼굴만 바꿔서 여러 장 뽑기 좋아요"></label>
    </div>
    <label>프롬프트<textarea name="prompt" class="lg-in mono" rows="8" required><%= e ? e.prompt : '' %></textarea></label>
    <label>부정 프롬프트 (선택)<textarea name="negative" class="lg-in mono" rows="2"><%= e ? e.negative || '' : '' %></textarea></label>
    <div class="lg-adimgs">
      <b>이미지 (최대 8장, 첫 장이 대표)</b>
      <div class="lg-adimgs-row" data-imgs>
        <% if (e) { e.image_ids.forEach(function(id){ %>
          <label class="lg-adimg"><img src="/u/img/<%= id %>" alt=""><span><input type="checkbox" name="keep" value="<%= id %>" checked> 남기기</span></label>
        <% }); } %>
      </div>
      <label class="lg-btn sm">📷 이미지 추가<input type="file" accept="image/*" multiple hidden data-multi-file></label>
      <p class="lg-hint">사진은 올리기 전에 자동으로 줄여서 저장돼요.</p>
    </div>
    <label class="lg-check"><input type="hidden" name="is_active" value="0"><input type="checkbox" name="is_active" value="1" <%= !e || e.is_active ? 'checked' : '' %>> 공개</label>
    <div class="lg-bbtns">
      <button class="lg-btn primary"><%= e ? '고친 내용 저장' : '올리기' %></button>
      <% if (e) { %><a href="/admin/lounge?tab=prompts" class="lg-btn ghost">새로 쓰기</a><a href="/prompts/<%= e.id %>" class="lg-btn ghost" target="_blank">페이지 보기</a><% } %>
    </div>
  </form>

  <div class="lg-mfilter mt">
    <a href="/admin/lounge?tab=prompts" class="<%= pf === 'official' ? 'on' : '' %>">✨ 바이란 프롬프트 <b><%= pcount.official %></b></a>
    <a href="/admin/lounge?tab=prompts&pf=shared" class="<%= pf === 'shared' ? 'on' : '' %>">🙌 회원 공유 <b><%= pcount.shared %></b></a>
    <a href="/admin/lounge?tab=prompts&pf=fix" class="<%= pf === 'fix' ? 'on' : '' %>">✏️ 수정 요청 중 <b><%= pcount.fix %></b></a>
  </div>
  <% if (pf !== 'official') { %><p class="lg-hint">회원 공유 프롬프트는 각 페이지에서 <b>수정 · 삭제 · 수정 요청</b>을 할 수 있어요. (페이지 보기 → 아래쪽 운영자 칸)</p><% } %>
  <div class="lg-admin-list">
    <% prompts.forEach(function(p){ %>
      <div class="lg-adrow <%= p.is_active ? '' : 'off' %>">
        <% if (p.image_ids.length) { %><img src="/u/img/<%= p.image_ids[0] %>" alt="" class="lg-adthumb"><% } else { %><span class="lg-adthumb"></span><% } %>
        <div class="grow"><b><%= p.title %></b><% if (p.status === 'fix') { %> <span class="lg-tag warn">수정 요청 중</span><% } %><small><%= p.user_id ? '🙋 ' + (p.author || '회원') + ' · ' : '' %><%= p.category %> · 조회 <%= p.views %> · 복사 <%= p.copies %> · <%= d(p.created_at) %></small><% if (p.status === 'fix') { %><small>요청: <%= p.fix_note %></small><% } %></div>
        <a href="/prompts/<%= p.id %>" class="lg-btn sm ghost" target="_blank">보기</a>
        <a href="<%= p.user_id ? '/prompts/' + p.id + '/edit' : '/admin/lounge?tab=prompts&edit=' + p.id + '#pform' %>" class="lg-btn sm">수정</a>
        <form method="post" action="/admin/lounge/prompts/<%= p.id %>/toggle" class="inline"><button class="lg-btn sm ghost"><%= p.is_active ? '숨기기' : '공개' %></button></form>
        <form method="post" action="/admin/lounge/prompts/<%= p.id %>/delete" class="inline" data-confirm="정말 지울까요?"><button class="lg-btn sm ghost danger">삭제</button></form>
      </div>
    <% }); %>
    <% if (!prompts.length) { %><p class="lg-muted">아직 올린 프롬프트가 없어요.</p><% } %>
  </div>
<% } %>

<% if (tab === 'library') { const e = edit; %>
  <form method="post" action="/admin/lounge/resources/save" class="lg-card lg-adform" id="rform">
    <h2 class="lg-h3"><%= e ? '자료 고치기' : '새 자료 올리기' %></h2>
    <% if (e) { %><input type="hidden" name="id" value="<%= e.id %>"><% } %>
    <div class="lg-adgrid">
      <label>제목<input name="title" class="lg-in" required maxlength="120" value="<%= e ? e.title : '' %>"></label>
      <label>칸 (자료실 구역)<select name="section" class="lg-in"><% L.SECTIONS.forEach(function(s){ %><option <%= e && e.section === s ? 'selected' : '' %>><%= s %></option><% }); %></select></label>
      <label>새 칸 이름 (직접 입력하면 위 선택보다 우선)<input name="section_custom" class="lg-in" maxlength="30"></label>
      <label>종류<select name="kind" class="lg-in">
        <% [['link','자료집(노션 등 링크)'],['pdf','PDF'],['video','강의 영상'],['text','글로 바로 보기']].forEach(function(k){ %><option value="<%= k[0] %>" <%= e && e.kind === k[0] ? 'selected' : '' %>><%= k[1] %></option><% }); %>
      </select></label>
      <label>링크 (노션 공개 주소, 구글드라이브 등)<input name="url" class="lg-in" value="<%= e ? e.url || '' : '' %>" placeholder="https://..."></label>
      <label>짧은 설명<input name="description" class="lg-in" maxlength="300" value="<%= e ? e.description || '' : '' %>"></label>
      <label>누가 볼 수 있나요<select name="access" class="lg-in">
        <option value="member" <%= e && e.access === 'member' ? 'selected' : '' %>>회원 누구나</option>
        <option value="points" <%= e && e.access === 'points' ? 'selected' : '' %>>💎 포인트로 여는 사람만</option>
        <option value="code" <%= e && e.access === 'code' ? 'selected' : '' %>>🎟 라이브 코드 넣은 사람만</option>
        <option value="course" <%= e && e.access === 'course' ? 'selected' : '' %>>🎓 수강생만</option>
      </select></label>
      <label>필요한 포인트 (포인트로 열 때)<input name="cost" type="number" min="0" step="10" class="lg-in" value="<%= e ? e.cost || '' : '' %>" placeholder="예: 1000"></label>
      <label>잠겼을 때 문구<input name="lock_note" class="lg-in" maxlength="120" value="<%= e ? e.lock_note || '' : '' %>" placeholder="무료 라이브에서 받아가세요"></label>
      <label>순서 (작을수록 위)<input name="sort_order" type="number" class="lg-in" value="<%= e ? e.sort_order : 100 %>"></label>
    </div>
    <fieldset class="lg-adfield">
      <legend>🎓 수강생만일 때, 어느 과정 수강생? (아무것도 안 고르면 수강생 누구나)</legend>
      <% products.forEach(function(p){ %>
        <label class="lg-check"><input type="checkbox" name="product_ids" value="<%= p.id %>" <%= e && e.product_ids && e.product_ids.includes(p.id) ? 'checked' : '' %>> <%= p.title %></label>
      <% }); %>
    </fieldset>
    <label>본문 (링크 대신 글로 보여줄 때)<textarea name="body" class="lg-in" rows="4"><%= e ? e.body || '' : '' %></textarea></label>
    <label class="lg-check"><input type="hidden" name="is_active" value="0"><input type="checkbox" name="is_active" value="1" <%= !e || e.is_active ? 'checked' : '' %>> 공개</label>
    <button class="lg-btn primary">저장</button>
    <p class="lg-hint">노션 자료집은 노션에서 [공유 → 웹에 게시]를 켠 뒤 나오는 주소를 넣어 주세요. 그래야 회원들이 열 수 있어요.</p>
  </form>
  <div class="lg-admin-list">
    <% resources.forEach(function(r){ %>
      <div class="lg-adrow <%= r.is_active ? '' : 'off' %>">
        <div class="grow"><b><%= r.title %></b><small><%= r.section %> · <%= r.access === 'code' ? '🎟 라이브 코드' : r.access === 'course' ? '🎓 수강생만' : r.access === 'points' ? '💎 ' + P.fmt(r.cost) + 'P' : '회원 무료' %> · 순서 <%= r.sort_order %> · 연 사람 <%= r.opened %></small></div>
        <a href="/admin/lounge?tab=library&edit=<%= r.id %>#rform" class="lg-btn sm">수정</a>
        <form method="post" action="/admin/lounge/resources/<%= r.id %>/delete" class="inline" data-confirm="정말 지울까요?"><button class="lg-btn sm ghost danger">삭제</button></form>
      </div>
    <% }); %>
  </div>
<% } %>

<% if (tab === 'store') { const e = edit; %>
  <form method="post" action="/admin/lounge/products/save" class="lg-card lg-adform" id="sform">
    <h2 class="lg-h3"><%= e ? '과정 고치기' : '새 과정 추가' %></h2>
    <% if (e) { %><input type="hidden" name="id" value="<%= e.id %>"><% } %>
    <div class="lg-adgrid">
      <label>종류<select name="ptype" class="lg-in"><option value="course" <%= !e || e.ptype !== 'ebook' ? 'selected' : '' %>>🎓 강의 · 1:1 과정</option><option value="ebook" <%= e && e.ptype === 'ebook' ? 'selected' : '' %>>📖 전자책</option></select></label>
      <label>이름<input name="title" class="lg-in" required maxlength="120" value="<%= e ? e.title : '' %>" placeholder="예: 사주 + 타로 과정"></label>
      <label>한 줄 설명<input name="subtitle" class="lg-in" maxlength="200" value="<%= e ? e.subtitle || '' : '' %>"></label>
      <label>분류 표시 (작은 글씨)<input name="kind" class="lg-in" maxlength="40" value="<%= e ? e.kind || '' : '' %>" placeholder="예: 1:1 피드백 · 4주"></label>
      <label>배지<input name="badge" class="lg-in" maxlength="12" value="<%= e ? e.badge || '' : '' %>" placeholder="예: 추천, BEST"></label>
      <label>판매 금액<input name="price_text" class="lg-in" maxlength="40" value="<%= e ? e.price_text || '' : '' %>" placeholder="예: 1,100,000원 / 금액 문의"></label>
      <label>정가 (줄 그어 보여줘요, 선택)<input name="list_price" class="lg-in" maxlength="40" value="<%= e ? e.list_price || '' : '' %>" placeholder="예: 1,300,000원"></label>
      <label>금액 옆 안내 (선택)<input name="price_note" class="lg-in" maxlength="120" value="<%= e ? e.price_note || '' : '' %>" placeholder="예: 해당 월 5명 한정 할인가"></label>
      <label>결제 링크 (선택, 아임웹·스마트스토어 등)<input name="buy_url" class="lg-in" value="<%= e ? e.buy_url || '' : '' %>"></label>
      <label>결제 버튼 글자<input name="cta_label" class="lg-in" maxlength="20" value="<%= e ? e.cta_label || '' : '' %>" placeholder="결제하기"></label>
      <label>순서<input name="sort_order" type="number" class="lg-in" value="<%= e ? e.sort_order : 100 %>"></label>
    </div>
    <label>포함 내용 (한 줄에 하나씩)<textarea name="perks" class="lg-in" rows="5" placeholder="1:1 피드백 6개월&#10;타로 자료집"><%= e ? e.perks || '' : '' %></textarea></label>
    <h2 class="lg-h3 mt">📈 팔릴수록 오르는 가격 (선택)</h2>
    <div class="lg-adgrid">
      <label>시작 가격 (원)<input name="dyn_start" type="number" min="0" step="1000" class="lg-in" value="<%= e && e.dyn_start ? e.dyn_start : '' %>" placeholder="예: 120000"></label>
      <label>몇 명 팔릴 때마다<input name="dyn_every" type="number" min="1" class="lg-in" value="<%= e && e.dyn_every ? e.dyn_every : '' %>" placeholder="예: 10"></label>
      <label>얼마씩 오를지 (원)<input name="dyn_step" type="number" min="0" step="500" class="lg-in" value="<%= e && e.dyn_step ? e.dyn_step : '' %>" placeholder="예: 2000"></label>
      <label>최대 가격 (원)<input name="dyn_max" type="number" min="0" step="1000" class="lg-in" value="<%= e && e.dyn_max ? e.dyn_max : '' %>" placeholder="예: 220000"></label>
    </div>
    <p class="lg-hint">네 칸을 다 채우면 위 '판매 금액' 대신 이 규칙으로 가격이 자동으로 정해져요. 카드·현금으로 산 사람만 세고, 무료 지급·환불은 빼요.<% if (e && e.dyn) { %> 지금 <b><%= e.dyn.sold %>명</b> 구매 · 현재 <b><%= e.price_text %></b><% } %></p>
    <h2 class="lg-h3 mt">🎓 수강생 화면</h2>
    <div class="lg-adgrid">
      <label>수강 기간 (개월, 비우면 평생)<input name="months" type="number" min="1" class="lg-in" value="<%= e && e.months ? e.months : '' %>" placeholder="예: 6"></label>
      <label>수강생 안내 문구<input name="student_note" class="lg-in" maxlength="500" value="<%= e ? e.student_note || '' : '' %>" placeholder="예: 수강 자료와 도구는 루월당에서 이용해요"></label>
    </div>
    <label>수강생에게 보여줄 링크 (한 줄에 하나, "이름 | 주소")<textarea name="student_links" class="lg-in" rows="3" placeholder="루월당 바로가기 | https://www.luwolsaju.com/home&#10;전자책 열기 | https://노션 공개 주소"><%= e ? e.student_links || '' : '' %></textarea></label>
    <p class="lg-hint">수강권이 있는 회원은 마이페이지에 "수강 중"으로 이 링크들이 떠요.</p>
    <label class="lg-check"><input type="checkbox" name="is_challenge" value="1" <%= e && e.is_challenge ? 'checked' : '' %>> 챌린지 과정 (챌린지 페이지로 연결)</label>
    <label class="lg-check"><input type="hidden" name="is_active" value="0"><input type="checkbox" name="is_active" value="1" <%= !e || e.is_active ? 'checked' : '' %>> 공개</label>
    <button class="lg-btn primary">저장</button>
  </form>
  <div class="lg-admin-list">
    <% products.forEach(function(p){ %>
      <div class="lg-adrow <%= p.is_active ? '' : 'off' %>">
        <div class="grow"><b><%= p.ptype === 'ebook' ? '📖 ' : '' %><%= p.title %></b><small><%= p.price_text || '금액 미정' %><%= p.list_price ? ' (정가 ' + p.list_price + ')' : '' %> · 기간 <%= p.months ? p.months + '개월' : '평생' %> · 순서 <%= p.sort_order %></small></div>
        <a href="/admin/lounge?tab=store&edit=<%= p.id %>#sform" class="lg-btn sm">수정</a>
        <form method="post" action="/admin/lounge/products/<%= p.id %>/delete" class="inline" data-confirm="정말 지울까요?"><button class="lg-btn sm ghost danger">삭제</button></form>
      </div>
    <% }); %>
  </div>
  <p class="lg-hint">수강 신청서는 기존 관리 화면의 <a href="/admin?tab=inquiries">문의</a> 탭에 "수강 신청 · 과정이름"으로 들어와요.</p>
<% } %>

<% if (tab === 'students') { %>
  <%
    const fd = (x) => { if (!x) return ''; const t = new Date(x); return t.getUTCFullYear() + '-' + String(t.getUTCMonth() + 1).padStart(2, '0') + '-' + String(t.getUTCDate()).padStart(2, '0'); };
    const today = new Date(Date.now() + 9 * 3600e3).toISOString().slice(0, 10);
    const grantForm = function (u, pick, inq) { %>
      <form method="post" action="/admin/lounge/enrollments/grant" class="lg-enr-grant" data-confirm="<%= u.nickname || u.name %>님에게 수강권을 지급할까요?">
        <input type="hidden" name="user_id" value="<%= u.id %>">
        <% if (inq) { %><input type="hidden" name="inquiry_id" value="<%= inq %>"><% } %>
        <label>과정<select name="product_id" class="lg-in" required>
          <% products.forEach(function(p){ %><option value="<%= p.id %>" <%= pick === p.id ? 'selected' : '' %>><%= p.title %> (<%= p.months ? p.months + '개월' : '평생' %>)</option><% }); %>
        </select></label>
        <label>결제 방법<select name="source" class="lg-in"><option value="cash">현금(계좌이체)</option><option value="card">카드</option><option value="admin">무료·기타</option></select></label>
        <label>받은 금액 (선택)<input name="amount" class="lg-in" inputmode="numeric" placeholder="예: 700000"></label>
        <label>시작일<input name="starts_on" type="date" class="lg-in" value="<%= today %>"></label>
        <label>기간<select name="period" class="lg-in"><option value="default">과정 기간대로</option><option value="lifetime">평생</option><option value="custom">직접 정하기 →</option></select></label>
        <label>끝나는 날 (직접 정할 때)<input name="ends_on" type="date" class="lg-in"></label>
        <label>메모 (선택)<input name="memo" class="lg-in" maxlength="300" placeholder="예: 9/29 계좌 입금 확인"></label>
        <button class="lg-btn primary">수강권 지급</button>
      </form>
  <% }; %>

  <div class="lg-card lg-adform" id="grant">
    <h2 class="lg-h3">🎟 수강권 직접 지급 (현금 결제 등)</h2>
    <p class="lg-hint">가입한 회원을 찾아서 수강권을 주면, 그 회원 마이페이지에 바로 "수강 중"으로 떠요. 카드 결제가 붙으면 결제 후 자동으로 지급돼요.</p>
    <form method="get" action="/admin/lounge" class="lg-inlineform">
      <input type="hidden" name="tab" value="students">
      <input name="s" class="lg-in" value="<%= s %>" placeholder="닉네임 · 이름 · 이메일 · 전화번호">
      <button class="lg-btn sm">회원 찾기</button>
    </form>
    <% found.forEach(function(u){ %>
      <div class="lg-adrow lg-enr-row" style="display:block">
        <b><%= u.nickname || '(닉네임 없음)' %></b> <small>(<%= u.name %><%= u.phone ? ' · ' + u.phone : '' %><%= u.email ? ' · ' + u.email : '' %> · <%= u.provider === 'kakao' ? '카카오' : '이메일' %> 가입 <%= fd(u.created_at) %>)</small>
        <% if (u.now_courses) { %><span class="lg-tag stu">🎓 <%= u.now_courses %></span><% } %>
        <% if (u.has_ebook && ebookCredit) { %><span class="lg-tag">📖 전자책 구매자 · 피드백 과정 결제 시 <%= L.won(ebookCredit) %> 차감</span><% } %>
        <% grantForm(u, null, null); %>
      </div>
    <% }); %>
    <% if ((s || uid) && !found.length) { %><p class="lg-muted">찾는 회원이 없어요. 카카오로 가입을 먼저 해 달라고 안내해 주세요.</p><% } %>
  </div>

  <h2 class="lg-h3 mt">📝 수강 신청서 (최근 30개)</h2>
  <div class="lg-admin-list">
    <% apps.forEach(function(a){ %>
      <div class="lg-adrow lg-enr-row" style="display:block">
        <b><%= a.name %></b> <small><%= a.phone %> · <%= a.plan.replace('수강 신청 · ', '') %> · <%= fd(a.created_at) %><%= a.status === 'done' ? ' · 처리 완료' : '' %></small>
        <% if (a.message) { %><p class="lg-muted" style="margin:4px 0 0"><%= a.message %></p><% } %>
        <% if (a.uid && ebookSet.has(a.uid) && ebookCredit) { %><span class="lg-tag">📖 전자책 구매자 · <%= L.won(ebookCredit) %> 차감</span><% } %>
        <% if (a.uid && enrolledSet.has(a.uid + ':' + a.product_id)) { %>
          <span class="lg-tag stu">🎓 이미 지급됨</span>
        <% } else if (a.uid) { %>
          <details><summary class="lg-linkbtn">이 회원(#<%= a.uid %>)에게 수강권 지급</summary><% grantForm({ id: a.uid, nickname: a.name }, a.product_id, a.id); %></details>
        <% } else { %>
          <small class="lg-muted">로그인 안 하고 신청한 분이에요. 가입 후 위에서 이름·전화번호로 찾아 지급해 주세요.</small>
        <% } %>
      </div>
    <% }); %>
    <% if (!apps.length) { %><p class="lg-muted">아직 수강 신청서가 없어요.</p><% } %>
  </div>

  <h2 class="lg-h3 mt">🎓 수강권 목록</h2>
  <nav class="lg-tabs">
    <a href="/admin/lounge?tab=students&st=active" class="<%= st === 'active' ? 'on' : '' %>">수강 중</a>
    <a href="/admin/lounge?tab=students&st=ended" class="<%= st === 'ended' ? 'on' : '' %>">종료·환불</a>
    <a href="/admin/lounge?tab=students&st=all" class="<%= st === 'all' ? 'on' : '' %>">전체</a>
  </nav>
  <div class="lg-admin-list">
    <% enrolls.forEach(function(e){ %>
      <div class="lg-adrow lg-enr-row <%= e.is_active ? '' : 'off' %>" style="display:block">
        <b><%= e.nick %></b> <small>(<%= e.name %><%= e.phone ? ' · ' + e.phone : '' %>)</small> · <b><%= e.product_title %></b>
        <small> · <%= E.SOURCES[e.source] %><%= e.amount ? ' ' + P.fmt(e.amount) + '원' : '' %><%= e.order_id ? ' · 주문 ' + e.order_id : '' %> · <%= e.is_active ? (e.ends_on ? e.days_left + '일 남음' : '평생') : (E.STATUSES[e.status] === '수강 중' ? '기간 끝남' : E.STATUSES[e.status]) %></small>
        <form method="post" action="/admin/lounge/enrollments/<%= e.id %>/save" class="lg-enr-edit">
          <input type="hidden" name="st" value="<%= st %>">
          <select name="status" class="lg-in" aria-label="상태"><% Object.keys(E.STATUSES).forEach(function(k){ %><option value="<%= k %>" <%= e.status === k ? 'selected' : '' %>><%= E.STATUSES[k] %></option><% }); %></select>
          <input type="date" name="starts_on" class="lg-in" value="<%= e.starts_s %>" aria-label="시작일">
          <span class="lg-muted">~</span>
          <input type="date" name="ends_on" class="lg-in" value="<%= e.ends_s || '' %>" aria-label="끝나는 날 (비우면 평생)" title="비우면 평생">
          <input name="memo" class="lg-in" maxlength="300" value="<%= e.memo || '' %>" placeholder="메모" aria-label="메모">
          <button class="lg-btn sm">저장</button>
        </form>
        <form method="post" action="/admin/lounge/enrollments/<%= e.id %>/delete" class="inline" data-confirm="이 수강권을 아예 지울까요? (보통은 상태를 '종료'나 '환불'로 바꾸는 걸 추천해요)"><input type="hidden" name="st" value="<%= st %>"><button class="lg-linkbtn sm danger">지우기</button></form>
      </div>
    <% }); %>
    <% if (!enrolls.length) { %><p class="lg-muted">해당하는 수강권이 없어요.</p><% } %>
  </div>
  <p class="lg-hint">끝나는 날을 비우면 평생이에요. 환불하면 상태를 '환불'로 바꿔 주세요. 그 순간 마이페이지에서 수강 화면이 닫혀요.</p>
<% } %>

<% if (tab === 'board') { %>
  <h2 class="lg-h3">🚨 신고 (<%= reports.length %>)</h2>
  <div class="lg-admin-list">
    <% reports.forEach(function(r){ %>
      <div class="lg-adrow">
        <div class="grow"><b><%= { post: '글', comment: '댓글', chat: '채팅', result: '인증샷' }[r.target_type] %></b> <%= r.preview || '(지워진 내용)' %><small>신고: <%= r.reporter || '?' %> · <%= d(r.created_at) %><% if (r.target_type === 'post') { %> · <a href="/community/<%= r.target_id %>" target="_blank">보기</a><% } else if (r.post_id) { %> · <a href="/community/<%= r.post_id %>" target="_blank">보기</a><% } %></small></div>
        <form method="post" action="/admin/lounge/reports/<%= r.id %>" class="inline"><input type="hidden" name="action" value="hide"><button class="lg-btn sm danger">숨기기</button></form>
        <form method="post" action="/admin/lounge/reports/<%= r.id %>" class="inline"><input type="hidden" name="action" value="keep"><button class="lg-btn sm ghost">그대로 두기</button></form>
      </div>
    <% }); %>
    <% if (!reports.length) { %><p class="lg-muted">처리할 신고가 없어요.</p><% } %>
  </div>
  <h2 class="lg-h3 mt">최근 글</h2>
  <div class="lg-admin-list">
    <% posts.forEach(function(p){ %>
      <div class="lg-adrow <%= p.is_hidden ? 'off' : '' %>">
        <div class="grow"><b>[<%= (L.CATEGORIES[p.category] || {}).label %>] <a href="/community/<%= p.id %>" target="_blank"><%= p.title %></a></b><small><%= p.nick %> · <%= d(p.created_at) %><%= p.is_pinned ? ' · 📌 고정' : '' %></small></div>
        <% if (p.category === 'notice') { %><form method="post" action="/admin/lounge/posts/<%= p.id %>/toggle" class="inline"><input type="hidden" name="field" value="pin"><button class="lg-btn sm ghost"><%= p.is_pinned ? '고정 해제' : '고정' %></button></form><% } %>
        <form method="post" action="/admin/lounge/posts/<%= p.id %>/toggle" class="inline"><input type="hidden" name="field" value="hide"><button class="lg-btn sm ghost"><%= p.is_hidden ? '다시 보이기' : '숨기기' %></button></form>
      </div>
    <% }); %>
  </div>
  <h2 class="lg-h3 mt">채팅</h2>
  <div class="lg-admin-list">
    <% chat.forEach(function(c){ %>
      <div class="lg-adrow <%= c.is_hidden ? 'off' : '' %>"><div class="grow"><b><%= c.nick %></b> <%= c.body %><small><%= d(c.created_at) %></small></div>
        <form method="post" action="/admin/lounge/chat/<%= c.id %>/toggle" class="inline"><button class="lg-btn sm ghost"><%= c.is_hidden ? '보이기' : '숨기기' %></button></form></div>
    <% }); %>
  </div>
  <h2 class="lg-h3 mt">성과 인증샷</h2>
  <div class="lg-admin-list">
    <% results.forEach(function(r){ %>
      <div class="lg-adrow <%= r.is_hidden ? 'off' : '' %>"><% if (r.image_id) { %><img src="/u/img/<%= r.image_id %>" alt="" class="lg-adthumb"><% } %><div class="grow"><b><%= r.headline %></b><small><%= r.nick %></small></div>
        <form method="post" action="/admin/lounge/results/<%= r.id %>/toggle" class="inline"><button class="lg-btn sm ghost"><%= r.is_hidden ? '보이기' : '숨기기' %></button></form></div>
    <% }); %>
  </div>
<% } %>

<% if (tab === 'reviews') { %>
  <form method="post" action="/admin/lounge/reviews/new" class="lg-card lg-adform">
    <h2 class="lg-h3">받은 후기 직접 올리기</h2>
    <p class="lg-hint">카톡이나 카페로 받은 <b>실제 후기</b>만 올려 주세요. 올리기 전에 본인에게 동의를 받아 주세요.</p>
    <div class="lg-adgrid">
      <label>작성자 표시 (예: 김**)<input name="author_name" class="lg-in" required maxlength="40"></label>
      <label>과정<select name="product_id" class="lg-in"><option value="">무료 자료집·라운지</option><% products.forEach(function(p){ %><option value="<%= p.id %>"><%= p.title %></option><% }); %></select></label>
      <label>별점<select name="rating" class="lg-in"><% for (let i = 5; i >= 1; i--) { %><option><%= i %></option><% } %></select></label>
      <label>하시는 일 (선택)<input name="industry" class="lg-in" maxlength="40"></label>
    </div>
    <label>내용<textarea name="body" class="lg-in" rows="3" required></textarea></label>
    <button class="lg-btn primary">올리기</button>
  </form>
  <div class="lg-admin-list">
    <% reviews.forEach(function(r){ %>
      <div class="lg-adrow <%= r.status === 'rejected' ? 'off' : '' %>">
        <% if (r.image_id) { %><img src="/u/img/<%= r.image_id %>" alt="" class="lg-adthumb"><% } %>
        <div class="grow"><b><span class="lg-tag <%= r.status === 'approved' ? 'ok' : r.status === 'pending' ? 'warn' : '' %>"><%= { approved: '올라감', pending: '대기', rejected: '반려' }[r.status] %></span> <%= '★'.repeat(r.rating) %> <%= r.nick %></b><small><%= r.product || '라운지' %> · <%= d(r.created_at) %></small><p><%= r.body %></p></div>
        <% if (r.status !== 'approved') { %><form method="post" action="/admin/lounge/reviews/<%= r.id %>/status" class="inline"><input type="hidden" name="status" value="approved"><button class="lg-btn sm primary">승인</button></form><% } %>
        <% if (r.status !== 'rejected') { %><form method="post" action="/admin/lounge/reviews/<%= r.id %>/status" class="inline"><input type="hidden" name="status" value="rejected"><button class="lg-btn sm ghost">반려</button></form><% } %>
        <form method="post" action="/admin/lounge/reviews/<%= r.id %>/delete" class="inline" data-confirm="정말 지울까요?"><button class="lg-btn sm ghost danger">삭제</button></form>
      </div>
    <% }); %>
  </div>
<% } %>

<% if (tab === 'challenge') { const e = editCohort; %>
  <div class="lg-tabs sub">
    <% cohorts.forEach(function(c){ %><a href="/admin/lounge?tab=challenge&c=<%= c.id %>" class="<%= cur && cur.id === c.id ? 'on' : '' %>"><%= c.name %> <small><%= { recruiting: '모집', running: '진행', ended: '종료' }[c.status] %></small></a><% }); %>
    <a href="/admin/lounge?tab=challenge&editc=0#cform">＋ 새 기수</a>
  </div>

  <% if (cur) { %>
    <div class="lg-card">
      <h2 class="lg-h3"><%= cur.name %> · <%= cur.title %></h2>
      <p class="lg-muted">시작 <%= d(cur.start_date) %> · <%= cur.days %>일 · 참가 <%= cur.approved %>명 · 대기 <%= cur.pending %>명 · 미션 <%= cur.missions %>개</p>
      <div class="lg-bbtns">
        <a href="/admin/lounge?tab=challenge&c=<%= cur.id %>&editc=<%= cur.id %>#cform" class="lg-btn sm">기수 정보 수정</a>
        <form method="post" action="/admin/lounge/cohorts/<%= cur.id %>/template" class="inline" data-confirm="비어 있는 날에 기본 미션(AI 블로그 14일)을 넣을까요?"><button class="lg-btn sm ghost">기본 미션 넣기</button></form>
        <form method="post" action="/admin/lounge/cohorts/<%= cur.id %>/delete" class="inline" data-confirm="기수와 제출물이 모두 지워져요. 정말 지울까요?"><button class="lg-btn sm ghost danger">기수 삭제</button></form>
      </div>
    </div>

    <h2 class="lg-h3 mt">참가자</h2>
    <form method="post" action="/admin/lounge/cohorts/<%= cur.id %>/add" class="lg-inlineform"><input name="nickname" class="lg-in" placeholder="닉네임으로 바로 추가" required><button class="lg-btn sm">추가</button></form>
    <div class="lg-admin-list">
      <% members.forEach(function(m){ %>
        <div class="lg-adrow <%= m.status === 'rejected' ? 'off' : '' %>">
          <div class="grow"><b><span class="lg-tag <%= m.status === 'approved' ? 'ok' : m.status === 'pending' ? 'warn' : '' %>"><%= { approved: '참가', pending: '대기', rejected: '거절' }[m.status] %></span> <%= m.nick %> <small>(<%= m.realname %>)</small></b><small>주문번호 <%= m.order_no || '-' %> · 연락처 <%= m.contact || '-' %> · 제출 <%= m.done %>개</small></div>
          <% if (m.status !== 'approved') { %><form method="post" action="/admin/lounge/cohorts/<%= cur.id %>/members/<%= m.user_id %>" class="inline"><input type="hidden" name="action" value="approve"><button class="lg-btn sm primary">승인</button></form><% } %>
          <% if (m.status === 'pending') { %><form method="post" action="/admin/lounge/cohorts/<%= cur.id %>/members/<%= m.user_id %>" class="inline"><input type="hidden" name="action" value="reject"><button class="lg-btn sm ghost">거절</button></form><% } %>
          <form method="post" action="/admin/lounge/cohorts/<%= cur.id %>/members/<%= m.user_id %>" class="inline" data-confirm="명단에서 뺄까요?"><input type="hidden" name="action" value="remove"><button class="lg-btn sm ghost danger">빼기</button></form>
        </div>
      <% }); %>
      <% if (!members.length) { %><p class="lg-muted">아직 신청이 없어요.</p><% } %>
    </div>

    <h2 class="lg-h3 mt">미션</h2>
    <form method="post" action="/admin/lounge/missions/save" class="lg-card lg-adform">
      <input type="hidden" name="cohort_id" value="<%= cur.id %>">
      <div class="lg-adgrid">
        <label>Day<input name="day" type="number" min="1" max="60" class="lg-in" required></label>
        <label>미션 제목<input name="title" class="lg-in" required maxlength="120"></label>
      </div>
      <label>설명<textarea name="body" class="lg-in" rows="3"></textarea></label>
      <button class="lg-btn sm primary">미션 저장 (같은 Day면 덮어써요)</button>
    </form>
    <div class="lg-admin-list">
      <% missions.forEach(function(m){ %>
        <div class="lg-adrow"><div class="grow"><b>Day <%= m.day %> · <%= m.title %></b><small><%= (m.body || '').slice(0, 80) %></small></div>
          <form method="post" action="/admin/lounge/missions/<%= m.id %>/delete" class="inline" data-confirm="미션을 지울까요?"><button class="lg-btn sm ghost danger">삭제</button></form></div>
      <% }); %>
    </div>

    <h2 class="lg-h3 mt">최근 제출</h2>
    <div class="lg-admin-list">
      <% subs.forEach(function(s){ %>
        <div class="lg-adrow"><div class="grow"><b>Day <%= s.day %> · <%= s.nick %></b><p><%= s.body %></p><% if (s.link) { %><a href="<%= s.link %>" target="_blank" rel="noopener"><%= s.link %></a><% } %><small><%= d(s.created_at) %></small></div></div>
      <% }); %>
    </div>
  <% } %>

  <form method="post" action="/admin/lounge/cohorts/save" class="lg-card lg-adform mt" id="cform">
    <h2 class="lg-h3"><%= e ? e.name + ' 수정' : '새 기수 만들기' %></h2>
    <% if (e) { %><input type="hidden" name="id" value="<%= e.id %>"><% } %>
    <div class="lg-adgrid">
      <label>기수 이름<input name="name" class="lg-in" required maxlength="20" value="<%= e ? e.name : '' %>" placeholder="예: 1기"></label>
      <label>제목<input name="title" class="lg-in" required maxlength="120" value="<%= e ? e.title : '' %>" placeholder="예: AI 블로그 14일 챌린지"></label>
      <label>시작일<input name="start_date" type="date" class="lg-in" required value="<%= e ? new Date(e.start_date).toISOString().slice(0,10) : '' %>"></label>
      <label>기간(일)<input name="days" type="number" min="1" max="60" class="lg-in" value="<%= e ? e.days : 14 %>"></label>
      <label>기수 카톡방 주소<input name="kakao_url" class="lg-in" value="<%= e ? e.kakao_url || '' : '' %>"></label>
      <label>상태<select name="status" class="lg-in"><% [['recruiting','모집 중'],['running','진행 중'],['ended','종료']].forEach(function(s){ %><option value="<%= s[0] %>" <%= e && e.status === s[0] ? 'selected' : '' %>><%= s[1] %></option><% }); %></select></label>
    </div>
    <label>소개<textarea name="intro" class="lg-in" rows="3"><%= e ? e.intro || '' : '' %></textarea></label>
    <button class="lg-btn primary">저장</button>
  </form>
<% } %>

<% if (tab === 'members') {
  const fd = (x) => x ? new Date(x).toLocaleDateString('ko-KR', { year: '2-digit', month: 'numeric', day: 'numeric', timeZone: 'Asia/Seoul' }) : '';
  const ago = function(x){ if (!x) return '—'; var d = Math.floor((Date.now() - new Date(x)) / 86400000); return d <= 0 ? '오늘' : d === 1 ? '어제' : d < 30 ? d + '일 전' : fd(x); };
  const kq = function(k){ return '/admin/lounge?tab=members' + (k ? '&k=' + k : '') + (s ? '&s=' + encodeURIComponent(s) : ''); };
%>
  <div class="lg-mfilter">
    <a href="<%= kq('') %>" class="<%= !kind ? 'on' : '' %>">전체 <b><%= kcount.all || 0 %></b></a>
    <% ['student','member','admin','suspended'].forEach(function(k){ if (!kcount[k] && kind !== k && k === 'suspended') return; %>
      <a href="<%= kq(k) %>" class="<%= kind === k ? 'on' : '' %>"><%= KINDS[k].label %> <b><%= kcount[k] || 0 %></b></a>
    <% }); %>
  </div>
  <form method="get" action="/admin/lounge" class="lg-inlineform">
    <input type="hidden" name="tab" value="members"><% if (kind) { %><input type="hidden" name="k" value="<%= kind %>"><% } %>
    <input name="s" class="lg-in" value="<%= s %>" placeholder="닉네임 · 카카오 이름 · 전화 · 이메일 · 메모 · 태그">
    <button class="lg-btn sm">검색</button>
    <a href="/admin/lounge/members.csv?<%= kind ? 'k=' + kind + '&' : '' %><%= s ? 's=' + encodeURIComponent(s) : '' %>" class="lg-btn sm ghost">엑셀로 받기</a>
  </form>
  <details class="lg-card lg-newmember" id="newmember" <%= msg && /^❗/.test(msg) ? "open" : "" %>>
    <summary>➕ 이메일로 회원 만들기 <small class="lg-muted">카카오 없이 이메일·비밀번호로 로그인하는 계정</small></summary>
    <form method="post" action="/admin/lounge/members/new" class="lg-adform" autocomplete="off">
      <div class="lg-nmgrid">
        <label>이메일<input name="email" type="email" class="lg-in" required maxlength="255" placeholder="helper@gmail.com" autocomplete="off"></label>
        <label>비밀번호 <small class="lg-muted">8자 이상</small><input name="password" type="text" class="lg-in" required minlength="8" maxlength="100" placeholder="처음 비밀번호" autocomplete="new-password"></label>
        <label>닉네임 <small class="lg-muted">선택 · 비우면 첫 로그인 때 직접 정해요</small><input name="nickname" class="lg-in" maxlength="10" placeholder="예: 바이란도우미"></label>
        <label>구분<select name="kind" class="lg-in">
          <option value="member">일반</option>
          <option value="student">🎓 수강생</option>
          <option value="admin">👑 운영자 (관리 화면·사이트 작업 가능)</option>
        </select></label>
      </div>
      <label>메모 <small class="lg-muted">선택</small><input name="memo" class="lg-in" maxlength="300" placeholder="예: 사이트 작업 도와주는 분"></label>
      <button class="lg-btn primary">계정 만들기</button>
      <p class="lg-hint">만든 뒤 이메일과 비밀번호를 그분께 알려 주세요. 로그인은 <b>byranmedia.com/login/email</b> 에서 해요. 비밀번호는 회원 화면에서 언제든 바꿀 수 있어요.</p>
    </form>
  </details>
  <p class="lg-hint">회원을 누르면 수강권 지급·기간 수정, 메모·태그, 포인트, 쓴 글까지 한 화면에서 봐요.</p>
  <div class="lg-mlist">
    <% members.forEach(function(m){ var K = KINDS[m.kind] || KINDS.member; %>
      <div class="lg-mrow">
      <a href="/admin/lounge/members/<%= m.id %>" class="lg-mrow-link">
        <span class="lg-ava"><%= (m.nickname || m.name || '?').slice(0,1) %></span>
        <span class="lg-mrow-main">
          <span class="lg-mrow-top">
            <b><%= m.nickname || '(닉네임 없음)' %></b><% if (m.country) { %><span title="<%= L.countryLabel(m.country) %>"><%= L.flag(m.country) %></span><% } %><small class="lg-muted"><%= m.name %></small>
            <i class="lg-kind <%= K.cls %>"><%= K.label %></i>
            <% if (m.has_ebook) { %><i class="lg-mtag">📖 전자책</i><% } %>
            <% if (!m.nickname) { %><i class="lg-mtag gray">프로필 전</i><% } %>
            <% if (m.chat_banned) { %><i class="lg-mtag red">💬 채팅 금지</i><% } %>
            <% if (m.write_banned) { %><i class="lg-mtag red">✍️ 글 금지</i><% } %>
            <% (m.admin_tags || '').split(',').filter(Boolean).forEach(function(t){ %><i class="lg-mtag"><%= t %></i><% }); %>
          </span>
          <% if (m.courses) { %><span class="lg-mrow-course">🎟 <%= m.courses %></span><% } %>
          <small class="lg-muted">가입 <%= fd(m.created_at) %> · 최근 <%= ago(m.seen_at) %><%= m.interest ? ' · ' + m.interest : '' %> · 글 <%= m.posts %> · 💎 <%= P.fmt(m.points) %>P<%= m.phone ? ' · 📞 ' + m.phone : '' %></small>
          <% if (m.memo) { %><small class="lg-mrow-memo">📝 <%= m.memo.split('\n')[0].slice(0, 60) %></small><% } %>
        </span>
      </a>
        <% if (m.kind !== 'admin') { %>
          <form method="post" action="/admin/lounge/members/<%= m.id %>/student" class="lg-mrow-act">
            <input type="hidden" name="on" value="<%= m.is_student ? '' : '1' %>">
            <input type="hidden" name="ret" value="/admin/lounge?tab=members<%= kind ? '&k=' + kind : '' %>">
            <button class="lg-btn sm <%= m.is_student ? 'ghost' : '' %>"><%= m.is_student ? '수강생 해제' : '🎓 수강생으로' %></button>
          </form>
        <% } %>
        <a href="/admin/lounge/members/<%= m.id %>" class="lg-mrow-go" aria-label="자세히">›</a>
      </div>
    <% }); %>
    <% if (!members.length) { %><p class="lg-muted">해당하는 회원이 없어요.</p><% } %>
  </div>
<% } %>

</section>
<%- include('_bottom') %>
