<%# 포인트 안내 띠: 잔액 + 오늘 받은 개수 %>
<% const PR = { post: +S.pt_post || 0, postDaily: +S.pt_post_daily || 0, review: +S.pt_review || 0, reviewDaily: +S.pt_review_daily || 0 }; %>
<% if (typeof pt !== 'undefined' && pt) { %>
  <div class="lg-ptbar">
    <div class="lg-ptbar-bal"><small>내 포인트</small><b>💎 <%= P.fmt(pt.balance) %>P</b></div>
    <div class="lg-ptbar-rules">
      <span>✍️ 글 쓰면 <b>+<%= pt.rules.post %>P</b> <em class="<%= pt.today.posts >= pt.rules.postDaily ? 'full' : '' %>">오늘 <%= Math.min(pt.today.posts, pt.rules.postDaily) %>/<%= pt.rules.postDaily %></em></span>
      <span>⭐ 후기 쓰면 <b>+<%= pt.rules.review %>P</b> <em class="<%= pt.today.reviews >= pt.rules.reviewDaily ? 'full' : '' %>">오늘 <%= Math.min(pt.today.reviews, pt.rules.reviewDaily) %>/<%= pt.rules.reviewDaily %></em></span>
    </div>
    <% if (!(typeof soon !== 'undefined' && soon && soon.library)) { %><a href="/library" class="lg-btn sm primary">포인트로 자료집 열기 →</a><% } %>
  </div>
<% } else { %>
  <div class="lg-ptbar guest">
    <div class="lg-ptbar-bal"><b>💎 활동하면 포인트가 쌓여요</b></div>
    <div class="lg-ptbar-rules">
      <span>✍️ 글 <b>+<%= PR.post %>P</b> <em>하루 <%= PR.postDaily %>개</em></span>
      <span>⭐ 후기 <b>+<%= PR.review %>P</b> <em>하루 <%= PR.reviewDaily %>개</em></span>
      <% if (!(typeof soon !== 'undefined' && soon && soon.library)) { %><span>📚 모은 포인트로 사주·타로·스레드 자료집 열기</span><% } %>
    </div>
    <% if (!user) { %><a href="/login?next=<%= encodeURIComponent(path) %>" class="lg-btn sm kakao">가입하고 모으기</a><% } %>
  </div>
<% } %>
