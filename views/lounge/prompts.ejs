<%- include('_top') %>
<%
  const qs = (o) => {
    const base = { cat: cat, q: q, sort: sort === 'new' ? '' : sort, fav: fav ? '1' : '', page: '' };
    const m = Object.assign(base, o);
    const s = Object.entries(m).filter(e => e[1]).map(e => e[0] + '=' + encodeURIComponent(e[1])).join('&');
    return (shared ? '/prompts/shared' : '/prompts') + (s ? '?' + s : '');
  };
  const isMember = !!(user && me);
  const shareHref = isMember ? '/prompts/share' : '/login?next=' + encodeURIComponent('/prompts/share');
%>
<section class="lg-wrap lg-pagehead lg-phead">
  <nav class="lg-pscope" aria-label="프롬프트 종류">
    <a href="/prompts" class="<%= shared ? '' : 'on' %>">✨ 바이란 프롬프트 <small><%= counts.official %></small></a>
    <a href="/prompts/shared" class="<%= shared ? 'on' : '' %>">🙌 모두의 프롬프트 <small><%= counts.shared %></small></a>
  </nav>
  <% if (shared) { %>
    <p class="lg-kicker">Shared by members · <%= all %> works</p>
    <h1 class="lg-display sm">모두의 프롬프트<br><em>회원들이 직접 만든 것</em></h1>
    <p class="lg-muted">바이란 회원들이 직접 만들어 공유한 프롬프트예요. 마음에 들면 복사해서 쓰고, 나만의 프롬프트도 공유해 주세요.</p>
    <p class="lg-pshare-top"><a href="<%= shareHref %>" class="lg-btn primary">＋ 내 프롬프트 공유하기</a><% if (!isMember) { %> <small class="lg-muted">가입한 회원만 공유할 수 있어요</small><% } %></p>
  <% } else { %>
    <p class="lg-kicker">AI Prompts · <%= all %> works</p>
    <h1 class="lg-display sm">이미지 누르고,<br><em>프롬프트는 그대로 복사</em></h1>
    <p class="lg-muted">AI로 만든 인물·화보·캐릭터 이미지와 그 프롬프트를 모았어요. 마음에 드는 이미지를 눌러 보세요.</p>
  <% } %>
</section>

<section class="lg-wrap">
  <a href="/prompts/builder" class="lg-builderbar">
    <span>🪄</span>
    <div><b>프롬프트 생성기로 나만의 프롬프트 만들기</b><small>패턴을 고르고 칸만 채우면 미드저니·챗지피티·Flux용 문장이 완성돼요</small></div>
    <em>생성기 열기 →</em>
  </a>
  <a href="/community?cat=request" class="lg-builderbar req">
    <span>💡</span>
    <div><b>원하는 프롬프트가 없나요? 요청해 주세요</b><small>컨셉만 적어 주시면 바이란이 프롬프트로 만들어 여기에 올려 드려요</small></div>
    <em>요청하기 →</em>
  </a>

  <form class="lg-pfilter" method="get" action="<%= shared ? "/prompts/shared" : "/prompts" %>" role="search">
    <div class="lg-pfilter-tabs">
      <a href="<%= qs({ fav: '' }) %>" class="<%= !fav ? 'on' : '' %>">전체 <small><%= all %></small></a>
      <% if (user) { %><a href="<%= qs({ fav: '1', page: '' }) %>" class="<%= fav ? 'on' : '' %>">♡ 즐겨찾기</a><% } %>
    </div>
    <div class="lg-pfilter-row">
      <input type="search" name="q" value="<%= q %>" placeholder="프롬프트나 제목으로 검색" class="lg-in" aria-label="검색">
      <% if (cat) { %><input type="hidden" name="cat" value="<%= cat %>"><% } %>
      <select name="sort" class="lg-in" aria-label="정렬" onchange="this.form.submit()">
        <option value="new" <%= sort === 'new' ? 'selected' : '' %>>최신순</option>
        <option value="popular" <%= sort === 'popular' ? 'selected' : '' %>>많이 복사한 순</option>
      </select>
      <button class="lg-btn primary">검색</button>
    </div>
    <nav class="lg-chipnav" aria-label="카테고리">
      <a href="<%= qs({ cat: '', page: '' }) %>" class="<%= !cat ? 'on' : '' %>">모든 카테고리</a>
      <% L.PROMPT_CATS.forEach(function(c){ if (!catCount[c]) return; %>
        <a href="<%= qs({ cat: c, page: '' }) %>" class="<%= cat === c ? 'on' : '' %>"><%= c %> <small><%= catCount[c] %></small></a>
      <% }); %>
    </nav>
  </form>
</section>

<% if (user && user.role === 'admin' && !shared) { %>
<section class="lg-wrap">
  <details class="lg-card lg-compose" id="compose" open>
    <summary><span class="lg-ava"><%= (nick || '운').slice(0,1) %></span><b>새 프롬프트 올리기</b><small>이미지와 프롬프트를 피드처럼 올려요 · 관리자만 보여요</small></summary>
    <form method="post" action="/admin/lounge/prompts/save" data-multi-image-form class="lg-compose-form">
      <input type="hidden" name="back" value="/prompts">
      <label class="lg-dropzone" data-dropzone>
        <input type="file" accept="image/*" multiple hidden data-multi-file>
        <span>📷 이미지를 여기로 끌어오거나 눌러서 고르세요 <small>(최대 8장 · 첫 장이 대표)</small></span>
      </label>
      <div class="lg-adimgs-row" data-imgs></div>
      <input name="title" class="lg-in" required maxlength="120" placeholder="제목 (예: 비 오는 날 카페 창가 셀카)">
      <textarea name="prompt" class="lg-in mono" rows="5" required placeholder="프롬프트를 붙여 넣으세요"></textarea>
      <details class="lg-compose-more">
        <summary>부정 프롬프트 · 메모 · 만든 도구 (선택)</summary>
        <textarea name="negative" class="lg-in mono" rows="2" placeholder="부정 프롬프트"></textarea>
        <input name="note" class="lg-in" maxlength="300" placeholder="한 줄 메모 (예: 얼굴만 바꿔서 여러 장 뽑기 좋아요)">
        <input name="model" class="lg-in" maxlength="40" placeholder="만든 도구 (예: 나노바나나, 미드저니 v7)">
      </details>
      <div class="lg-compose-foot">
        <select name="category" class="lg-in" aria-label="카테고리"><% L.PROMPT_CATS.forEach(function(c){ %><option><%= c %></option><% }); %></select>
        <input type="hidden" name="is_active" value="1">
        <span class="lg-grow"></span>
        <button class="lg-btn primary">올리기</button>
      </div>
    </form>
  </details>
</section>
<% } %>

<section class="lg-wrap lg-sec">
  <% if (items.length) { %>
    <div class="lg-pgrid">
      <% items.forEach(function(p){ %>
        <a href="/prompts/<%= p.id %>" class="lg-pcard">
          <div class="lg-pcard-img">
            <% if (p.image_ids.length) { %>
              <img src="/u/img/<%= p.image_ids[0] %>" alt="<%= p.title %>" loading="lazy">
              <% if (p.image_ids.length > 1) { %><span class="n">▣ <%= p.image_ids.length %></span><% } %>
            <% } else { %>
              <div class="lg-pcard-noimg">텍스트 프롬프트</div>
            <% } %>
          </div>
          <div class="lg-pcard-meta"><span><%= shared ? '🙋 ' + (p.author || '회원') : 'NO. ' + String(p.id).padStart(3, '0') %></span><span><%= p.category %></span></div>
          <b><%= p.title %></b>
          <p class="lg-pcard-pre"><%= p.preview %>…</p>
        </a>
      <% }); %>
    </div>
    <% if (pages > 1) { %>
      <nav class="lg-pager" aria-label="페이지">
        <% for (let i = 1; i <= pages; i++) { if (pages > 9 && Math.abs(i - page) > 3 && i !== 1 && i !== pages) continue; %>
          <a href="<%= qs({ page: i > 1 ? String(i) : '' }) %>" class="<%= i === page ? 'on' : '' %>"><%= i %></a>
        <% } %>
      </nav>
    <% } %>
  <% } else { %>
    <div class="lg-card lg-empty">
      <% if (fav) { %>
        <b>아직 즐겨찾기한 프롬프트가 없어요</b><p>마음에 드는 프롬프트에서 ♡를 눌러 보세요.</p>
      <% } else if (q || cat) { %>
        <b>찾는 프롬프트가 없어요</b><p>다른 단어로 검색해 보세요.</p>
      <% } else { %>
        <% if (shared) { %>
          <b>아직 공유된 프롬프트가 없어요</b><p>첫 번째로 <a href="<%= shareHref %>">내 프롬프트를 공유</a>해 주세요!</p>
        <% } else { %>
          <b>프롬프트를 채우고 있어요</b><p>곧 올라와요. 그동안 <a href="/prompts/builder">프롬프트 생성기</a>로 직접 만들어 보세요!</p>
        <% } %>
      <% } %>
    </div>
  <% } %>
</section>

<section class="lg-wrap lg-sec">
  <div class="lg-pshare">
    <% if (shared) { %>
      <div><b>✨ 바이란이 직접 만든 프롬프트도 보세요</b><p>운영자가 만들어 올리는 공식 프롬프트 모음이에요.</p></div>
      <a href="/prompts" class="lg-btn">바이란 프롬프트 보러가기 →</a>
    <% } else { %>
      <div><b>🙌 모두의 프롬프트</b><p>바이란 회원들이 직접 만들어 공유한 프롬프트도 구경해 보세요. 내 프롬프트를 공유할 수도 있어요.</p></div>
      <div class="lg-pshare-b">
        <a href="/prompts/shared" class="lg-btn">회원들이 공유한 프롬프트 보러가기 →</a>
        <a href="<%= shareHref %>" class="lg-btn primary">＋ 프롬프트 공유하기</a>
      </div>
    <% } %>
  </div>
</section>
<%- include('_bottom') %>
