<%- include('_top') %>
<%
  const isAdmin = user && user.role === 'admin';
  const isMember = !!(user && me);
  const qs = (o) => '?' + Object.entries(Object.assign({ cat: cat, page: '' }, o)).filter(e => e[1]).map(e => e[0] + '=' + encodeURIComponent(e[1])).join('&');
  const loginTo = (to) => '/login?next=' + encodeURIComponent(to);
%>
<section class="lg-wrap narrow lg-pagehead lg-chead">
  <h1 class="lg-h1">커뮤니티</h1>
  <p class="lg-muted">같이 이야기하고, 원하는 프롬프트를 요청하고, 오늘 한 걸 인증해요.</p>
  <%- include('_cnav') %>
</section>

<section class="lg-wrap narrow lg-csec">

<% if (cat === 'chat') { %>
  <%- include('_openchat') %>
  <div class="lg-card lg-chat tall" data-chat data-after="0" data-me="<%= user && me ? user.id : '' %>" data-login="<%= isMember ? '1' : '' %>">
    <div class="lg-card-h">
      <h3># 실시간 수다방</h3>
      <span class="lg-live"><i></i> <span data-online>지금</span></span>
    </div>
    <ul class="lg-chat-list" data-list>
      <li class="lg-muted lg-chat-empty" data-emptyrow>불러오는 중…</li>
    </ul>
    <% if (isMember) { %>
      <form class="lg-chat-form" data-chatform>
        <input name="body" maxlength="300" placeholder="메시지 보내기" autocomplete="off" aria-label="채팅 메시지">
        <button class="lg-btn primary sm">전송</button>
      </form>
    <% } else { %>
      <a href="<%= loginTo('/community') %>" class="lg-chat-lock">💬 카카오로 가입하고 같이 이야기하기</a>
    <% } %>
  </div>

<% } else { %>
  <% const isReq = cat === 'request'; const canWrite = isReq || isMember; %>
  <div class="lg-cintro <%= isReq ? 'req' : 'proof' %>">
    <div>
      <b><%= isReq ? '🎨 이런 프롬프트가 있으면 좋겠다!' : '✅ 오늘 한 걸 인증해요' %></b>
      <p><%= isReq ? '원하는 컨셉을 적어 주시면 바이란이 프롬프트로 만들어 AI 프롬프트에 올려 드려요. 로그인 없이도 남길 수 있어요.' : '블로그 글 발행, 스레드 업로드, 첫 수익까지. 작은 것도 좋아요. 인증하면 포인트가 쌓여요.' %></p>
    </div>
    <% if (canWrite) { %>
      <a href="<%= qs({ write: '1' }) %>#write" class="lg-btn primary sm" data-openwrite><%= isReq ? '요청하기' : '인증하기' %></a>
    <% } else { %>
      <a href="<%= loginTo('/community?cat=proof&write=1') %>" class="lg-btn kakao sm">가입하고 인증하기</a>
    <% } %>
  </div>

  <% if (canWrite) { %>
    <form method="post" action="/community" id="write" class="lg-card lg-cwrite" data-image-form <%= write ? '' : 'hidden' %>>
      <input type="hidden" name="category" value="<%= cat %>">
      <% if (!isMember) { %>
        <input name="guest_name" class="lg-in" maxlength="20" placeholder="이름 (선택 · 비워도 돼요)" autocomplete="nickname">
        <input name="website" tabindex="-1" autocomplete="off" class="lg-hp" aria-hidden="true">
      <% } %>
      <input name="title" class="lg-in" maxlength="120" required placeholder="<%= isReq ? '예: 벚꽃 아래 한복 입은 인물 화보' : '예: 블로그 글 1개 발행!' %>">
      <textarea name="body" class="lg-in" rows="6" maxlength="5000" required placeholder="<%= isReq ? '원하는 컨셉을 자유롭게 적어 주세요.\n- 누가/무엇이: 20대 여성, 강아지, 제품 사진 등\n- 분위기·스타일: 실사, 애니, 파스텔, 필름 느낌 등\n- 장소·배경, 옷, 색감, 구도\n- 어디에 쓸지: 스레드 프로필, 블로그 썸네일 등' : '오늘 한 일을 적어 주세요.\n- 블로그 글 1개 발행 (링크)\n- 제목을 3번 고쳐 봤어요\n- 내일은 키워드 찾기!' %>"></textarea>
      <div class="lg-write-foot">
        <% if (isMember) { %>
          <label class="lg-btn sm ghost lg-filebtn">📷 사진<input type="file" accept="image/*" data-file hidden></label>
          <img alt="" data-preview hidden class="lg-thumb">
          <input type="hidden" name="image" data-image>
        <% } %>
        <span class="lg-grow"></span>
        <button type="submit" class="lg-btn primary"><%= isReq ? '요청 남기기' : '올리기' %></button>
      </div>
      <% if (!isMember) { %><p class="lg-hint">로그인 없이 남긴 글은 지울 수 없어요. 프롬프트가 올라오면 이 글에 표시돼요.</p><% } else { %><p class="lg-hint">💎 20자 이상 쓰면 +<%= S.pt_post %>P (하루 <%= S.pt_post_daily %>개까지)</p><% } %>
    </form>
  <% } %>

  <div class="lg-card flush">
    <ul class="lg-board">
      <% posts.forEach(function(p){ %>
        <li>
          <a href="/community/<%= p.id %>">
            <span class="t">
              <% if (isReq) { %><i class="lg-reqstate <%= p.prompt_id ? 'done' : '' %>"><%= p.prompt_id ? '완료' : '접수' %></i><% } %>
              <%= p.title %>
              <% if (p.image_id) { %> <span class="lg-muted" title="사진 있음">📷</span><% } %>
              <% if (p.comments) { %> <em>[<%= p.comments %>]</em><% } %>
            </span>
            <span class="m"><%= p.nick %><%= p.role === 'admin' ? ' 👑' : '' %> · <%= L.ago(p.created_at) %><% if (!isReq) { %> · ♥ <%= p.likes %><% } %></span>
          </a>
        </li>
      <% }); %>
      <% if (!posts.length) { %>
        <li class="lg-empty-row"><%= isReq ? '아직 요청이 없어요. 첫 요청을 남겨 주세요!' : '아직 인증이 없어요. 오늘 한 것부터 남겨 주세요!' %></li>
      <% } %>
    </ul>
  </div>

  <% if (pages > 1) { %>
    <nav class="lg-pager" aria-label="페이지">
      <% for (let i = 1; i <= pages; i++) { if (pages > 9 && Math.abs(i - page) > 3 && i !== 1 && i !== pages) continue; %>
        <a href="/community<%= qs({ page: i > 1 ? String(i) : '' }) %>" class="<%= i === page ? 'on' : '' %>"><%= i %></a>
      <% } %>
    </nav>
  <% } %>
<% } %>
</section>
<%- include('_bottom') %>
