<%- include('_top') %>
<%
  const isAdminU = user && user.role === 'admin';
  const isMember = !!(user && me);
  const shareHref = isMember ? '/prompts/share' : '/login?next=' + encodeURIComponent('/prompts/share');
%>
<section class="lg-wrap lg-sec">
  <a href="<%= p.user_id ? '/prompts/shared' : '/prompts' %>" class="lg-back">← <%= p.user_id ? '모두의 프롬프트' : '프롬프트 모음' %></a>
  <% if (p.status === 'fix') { %>
    <div class="lg-alert warn">✏️ <b>운영자 수정 요청</b> — <%= p.fix_note %><br><small><%= mine ? '고쳐서 저장하면 다시 공개돼요. 그 전까지는 목록에 안 보여요.' : '올린 분이 고칠 때까지 목록에서 숨겨져 있어요.' %></small><% if (mine) { %> <a href="/prompts/<%= p.id %>/edit" class="lg-btn sm primary">지금 고치기</a><% } %></div>
  <% } else if (!p.is_active) { %>
    <div class="lg-alert warn">숨김 처리된 프롬프트예요. (운영자에게만 보여요)</div>
  <% } %>
  <div class="lg-pdetail">
    <div class="lg-pdetail-media" data-gallery>
      <% if (p.image_ids.length) { %>
        <figure class="lg-pmain"><img src="/u/img/<%= p.image_ids[0] %>" alt="<%= p.title %>" data-main></figure>
        <% if (p.image_ids.length > 1) { %>
          <div class="lg-pthumbs">
            <% p.image_ids.forEach(function(id, i){ %>
              <button type="button" class="<%= i === 0 ? 'on' : '' %>" data-thumb="/u/img/<%= id %>" aria-label="<%= i + 1 %>번째 이미지"><img src="/u/img/<%= id %>" alt="" loading="lazy"></button>
            <% }); %>
          </div>
        <% } %>
      <% } else { %>
        <div class="lg-pcard-noimg big">텍스트 프롬프트</div>
      <% } %>
    </div>

    <div class="lg-pdetail-body">
      <div class="lg-pcard-meta"><span><% if (p.user_id) { %><a href="/member/<%= p.user_id %>" class="lg-pauthor"><%- include('_ava', { u: { id: p.user_id, nick: p.author, avatar_id: p.author_avatar }, size: 'xs', link: false }) %><%= p.author || '회원' %> <%= L.flag(p.author_country) %></a>님이 공유<% } else { %>NO. <%= String(p.id).padStart(3, '0') %><% } %></span><span><%= p.category %></span><% if (p.model) { %><span><%= p.model %></span><% } %></div>
      <h1 class="lg-h1"><%= p.title %></h1>
      <% if (p.note) { %><p class="lg-muted"><%= p.note %></p><% } %>

      <div class="lg-pbox">
        <div class="lg-pbox-h">
          <b>PROMPT</b>
          <% if (canCopy) { %>
            <button type="button" class="lg-btn primary sm" data-copy-target="#promptText" data-copied-post="/prompts/<%= p.id %>/copied">복사하기</button>
          <% } %>
        </div>
        <pre id="promptText" class="<%= canCopy ? '' : 'faded' %>"><%= shown %><% if (!canCopy) { %>…<% } %></pre>
        <% if (!canCopy) { %>
          <div class="lg-pbox-lock">
            <p><b>회원들이 공유한 프롬프트는 가입한 회원에게 보여요</b><br>카카오로 3초면 가입되고, 모두의 프롬프트를 전부 복사할 수 있어요. (바이란 프롬프트는 가입 없이도 복사돼요)</p>
            <a href="<%= user ? '/onboard?next=/prompts/' + p.id : '/login?next=/prompts/' + p.id %>" class="lg-btn kakao"><%= user ? '닉네임 정하고 보기' : '카카오로 3초 시작' %></a>
          </div>
        <% } %>
      </div>

      <% if (canCopy && p.negative) { %>
        <div class="lg-pbox neg">
          <div class="lg-pbox-h">
            <b>NEGATIVE</b>
            <button type="button" class="lg-btn sm" data-copy-target="#negText">복사</button>
          </div>
          <pre id="negText"><%= p.negative %></pre>
        </div>
      <% } %>

      <div class="lg-pactions">
        <button type="button" class="lg-heart <%= hearted ? 'on' : '' %>" data-pheart="<%= p.id %>" aria-pressed="<%= hearted %>"><i>♥</i> <span data-hearts><%= p.hearts %></span></button>
        <% if (user && me) { %>
          <button type="button" class="lg-like <%= liked ? 'on' : '' %>" data-plike="<%= p.id %>">⭐ <span data-liketext><%= liked ? '즐겨찾기됨' : '즐겨찾기' %></span> <small data-favs><%= p.favs %></small></button>
        <% } else { %>
          <span class="lg-like">⭐ 즐겨찾기 <small><%= p.favs %></small></span>
        <% } %>
        <button type="button" class="lg-linkbtn" data-copylink>🔗 링크 복사</button>
        <a href="/prompts/builder" class="lg-linkbtn">🪄 생성기로 변형하기</a>
        <% if (isAdminU || mine) { %>
          <a href="/prompts/<%= p.id %>/edit" class="lg-linkbtn">✏️ 수정</a>
          <form method="post" action="/prompts/<%= p.id %>/delete" class="inline" data-confirm="이 프롬프트를 지울까요? 되돌릴 수 없어요."><button class="lg-linkbtn danger">🗑 삭제</button></form>
        <% } %>
      </div>
      <% if (isAdminU && p.user_id) { %>
        <form method="post" action="/prompts/<%= p.id %>/fix" class="lg-pfix" id="fix">
          <b>👑 운영자: 올린 분에게 수정 요청</b>
          <% if (p.status === 'fix') { %>
            <p class="lg-muted">지금 수정 요청 중이에요: "<%= p.fix_note %>"</p>
            <input type="hidden" name="clear" value="1">
            <button class="lg-btn sm">요청 풀고 다시 공개</button>
          <% } else { %>
            <textarea name="note" class="lg-in" rows="2" maxlength="500" required placeholder="예: 다른 사람 사진이 들어 있어요. 직접 만든 이미지로 바꿔 주세요."></textarea>
            <button class="lg-btn sm primary">수정 요청 보내기</button>
            <small class="lg-muted">보내면 고칠 때까지 목록에서 숨겨지고, 올린 분 화면 위쪽과 마이페이지에 요청 내용이 떠요.</small>
          <% } %>
        </form>
      <% } %>
      <p class="lg-pstats">📋 <b><%= p.copiers %></b>명이 복사해 갔어요 · 👀 조회 <%= p.views + 1 %> · <%= p.date_s %></p>
      <p class="lg-hint">복사한 프롬프트는 미드저니, 챗지피티(이미지), 나노바나나, Flux 등에 붙여 넣어 쓰세요. 도구마다 결과가 조금씩 달라요.</p>
    </div>
  </div>
</section>

<section class="lg-wrap lg-sec">
  <div class="lg-pshare">
    <div><b>🙌 나도 프롬프트 공유하기</b><p>직접 만든 프롬프트를 올리면 <a href="/prompts/shared">모두의 프롬프트</a>에서 다른 회원들이 볼 수 있어요.<% if (!isMember) { %> (가입한 회원만)<% } %></p></div>
    <div class="lg-pshare-b">
      <a href="/prompts/shared" class="lg-btn">회원들이 공유한 프롬프트 보러가기 →</a>
      <a href="<%= shareHref %>" class="lg-btn primary">＋ 프롬프트 공유하기</a>
    </div>
  </div>
  <div class="lg-openchat-wrap"><%- include('_openchat') %></div>
</section>

<% if (more.length) { %>
<section class="lg-wrap lg-sec">
  <div class="lg-sec-h"><h2 class="lg-h2">비슷한 프롬프트</h2><a href="/prompts?cat=<%= encodeURIComponent(p.category) %>" class="lg-more">더 보기 →</a></div>
  <div class="lg-pgrid mini">
    <% more.forEach(function(m){ %>
      <a href="/prompts/<%= m.id %>" class="lg-pcard">
        <div class="lg-pcard-img"><img src="/u/img/<%= m.image_ids[0] %>" alt="<%= m.title %>" loading="lazy"></div>
        <b><%= m.title %></b>
      </a>
    <% }); %>
  </div>
</section>
<% } %>
<%- include('_bottom') %>
