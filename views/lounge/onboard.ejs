<%- include('_top', { active: '' }) %>
<section class="lg-wrap narrow lg-sec">
  <div class="lg-card lg-onboard">
    <p class="lg-kicker">👋 환영해요</p>
    <h1 class="lg-h1"><%= user.nickname ? '프로필 바꾸기' : '라운지에서 쓸 이름을 정해 주세요' %></h1>
    <p class="lg-muted">닉네임은 게시판·채팅에 보여요. 실명이 아니어도 괜찮아요.<br><small>Choose a nickname and your country. Any language is OK.</small></p>

    <% if (error) { %><div class="lg-alert err"><%= error %></div><% } %>

    <form method="post" action="/onboard">
      <input type="hidden" name="next" value="<%= next %>">
      <label class="lg-lb" for="nick">닉네임 <small class="lg-muted">Nickname</small></label>
      <input id="nick" name="nickname" class="lg-in" maxlength="10" required value="<%= form.nickname %>" placeholder="2~10자" autocomplete="off" autofocus>
      <ul class="lg-rules">
        <li>2~10자, 글자·숫자 (한글·영어·日本語·中文 등 모두 가능, 띄어쓰기 가능)</li>
        <li>욕설이나 운영자처럼 보이는 이름은 쓸 수 없어요</li>
      </ul>

      <label class="lg-lb" for="country">나라 <small class="lg-muted">Country</small></label>
      <select id="country" name="country" class="lg-in" required>
        <% L.COUNTRIES.forEach(function(c){ %>
          <option value="<%= c[0] %>" <%= form.country === c[0] ? 'selected' : '' %>><%= L.flag(c[0]) %> <%= c[1] %> · <%= c[2] %></option>
        <% }); %>
      </select>
      <p class="lg-hint">채팅에서 닉네임 옆에 국기로 보여요. (다른 나라에서 오신 분만)</p>

      <label class="lg-lb">요즘 관심 있는 것 <small class="lg-muted">Interest</small></label>
      <div class="lg-chips">
        <% L.INTERESTS.forEach(function(x){ %>
          <label class="lg-chip"><input type="radio" name="interest" value="<%= x %>" <%= form.interest === x ? 'checked' : '' %>><span><%= x %></span></label>
        <% }); %>
      </div>

      <button type="submit" class="lg-btn primary block lg"><%= user.nickname ? '저장하기' : '시작하기' %></button>
    </form>
  </div>
</section>
<%- include('_bottom') %>
