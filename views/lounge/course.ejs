<%- include('_top') %>
<%
  const perksOf = (p) => String(p.perks || '').split('\n').map(s => s.trim()).filter(Boolean);
  const ebooks = products.filter(function(p){ return p.ptype === 'ebook'; });
  const courses = products.filter(function(p){ return p.ptype !== 'ebook'; });
  const eb = ebooks[0] || null;
  const credit = eb ? L.priceNum(eb.price_text) : 0;
  const hasEb = eb && mine.includes(eb.id);
%>
<!-- 1. 첫 화면 -->
<section class="lg-hero lg-cohero">
  <div class="lg-wrap">
    <p class="lg-kicker">바이란 · AI 사주·타로 부업<%= eb ? ' · 전자책 · 1:1 피드백' : '' %></p>
    <h1 class="lg-display">사주를 몰라도,<br><em>고객 모집부터 상담 운영까지</em></h1>
    <p class="lg-hero-sub"><%= S.course_note || '사주를 공부하는 강의가 아니에요. AI로 사주·타로 부업을 시작해서 무엇을 팔지, 어떻게 고객을 모을지, 막히면 어떻게 풀지까지 실제로 해보는 과정이에요.' %></p>
    <div class="lg-hero-cta">
      <a href="#steps" class="lg-btn primary lg">단계·금액 보기</a>
      <% if (eb) { %><a href="#ebook" class="lg-btn lg">혼자 해볼래요 · 전자책</a><% } %>
      <a href="<%= S.consult_url %>" target="_blank" rel="noopener" class="lg-btn kakao lg">카톡으로 먼저 물어보기</a>
    </div>
    <div class="lg-cohero-chips">
      <span>🤖 AI로 사주·타로</span><span>🧾 상품·단가 만들기</span><span>🧵 스레드로 고객 모으기</span><span>⚙️ 스레드 자동화</span><span>🙋 1:1 피드백</span>
    </div>
  </div>
</section>

<!-- 1-2. 단계 고르기: 무료 자료집 → 전자책 → 강의 -->
<section class="lg-wrap lg-sec" id="steps">
  <div class="lg-sec-h"><div><p class="lg-kicker">Choose your step</p><h2 class="lg-h2">나에게 맞는 단계 고르기</h2><p class="lg-muted">같은 사주·타로 부업이라도, 얼마나 자세히 알려드리는지가 달라요.</p></div></div>
  <div class="lg-ladder">
    <div class="lg-rung">
      <span class="lg-rung-n">1단계</span>
      <h3>무료 프롬프트 · 자료집</h3>
      <p class="lg-rung-price">0원 <small>가입하면</small></p>
      <p class="lg-rung-lead"><b>큰 길</b>만 보여 드려요</p>
      <ul class="lg-check-list sm">
        <li>이런 부업이 있다</li>
        <li>어디서 하는지 · 무엇으로 하는지</li>
        <li>어떻게 하는지 큰 흐름</li>
      </ul>
      <a href="/library" class="lg-btn block">자료실에서 보기</a>
    </div>
    <% if (eb) { %>
    <div class="lg-rung mid">
      <span class="lg-rung-n">2단계</span>
      <h3>사주·타로 전자책</h3>
      <p class="lg-rung-price"><%= eb.price_text || '금액 문의' %></p>
      <p class="lg-rung-lead"><b>루트 하나하나</b> 알려 드려요</p>
      <ul class="lg-check-list sm">
        <li>AI로 사주 풀이 · 타로 상담 · 리포트 만들기</li>
        <li>상품 구성 · 기본 운영까지 바로 쓰는 프롬프트로</li>
        <li>1:1 피드백 없이 혼자 보고 실행</li>
      </ul>
      <a href="#ebook" class="lg-btn block">전자책 보기</a>
    </div>
    <% } %>
    <div class="lg-rung top">
      <span class="lg-rung-n"><%= eb ? '3단계' : '2단계' %></span>
      <h3>1:1 피드백 과정</h3>
      <p class="lg-rung-price"><%= courses[0] && courses[0].price_text ? courses[0].price_text + '부터' : '금액 문의' %></p>
      <p class="lg-rung-lead"><b>진짜 세세하게</b> 같이 가요</p>
      <ul class="lg-check-list sm">
        <li>고객 모집 · 스레드 운영까지 하나하나</li>
        <li>상담 세팅 · 상품 만들기를 같이</li>
        <li>막힐 때마다 1:1 피드백 · 매월 5명만</li>
      </ul>
      <a href="#plans" class="lg-btn primary block">과정 보기</a>
    </div>
  </div>
  <% if (credit) { %><p class="lg-credit-note">📖 전자책을 먼저 사고 1:1 피드백 과정으로 넘어오시면 <b>전자책 금액 <%= L.won(credit) %>을 전액 차감</b>해 드려요. 먼저 사도 손해 보지 않아요.</p><% } %>
</section>

<!-- 2. 누구에게 -->
<section class="lg-wrap lg-sec">
  <div class="lg-sec-h"><div><p class="lg-kicker">For you</p><h2 class="lg-h2">이런 분께 맞아요</h2></div></div>
  <div class="lg-fit">
    <div class="lg-card">
      <h3 class="lg-h3">👍 이런 분께 권해요</h3>
      <ul class="lg-check-list">
        <li>사주·타로를 몰라도 AI로 부업을 시작해 보고 싶은 분</li>
        <li>무엇을 팔고 어떻게 고객을 모을지 막막한 분</li>
        <li>스레드로 꾸준히 문의를 받고 싶은 분</li>
        <li>막힐 때마다 물어볼 사람이 필요한 분</li>
        <li>혼자 해볼 분은 전자책, 같이 가고 싶은 분은 1:1 피드백</li>
      </ul>
    </div>
    <div class="lg-card muted">
      <h3 class="lg-h3">🙅 이런 분께는 권하지 않아요</h3>
      <ul class="lg-x-list">
        <li>손 하나 안 대고 돈이 들어오는 완전 자동화를 기대하는 분</li>
        <li>알려드린 걸 직접 해보지 않으려는 분</li>
        <li>명리학·타로를 학문으로 깊게 공부하고 싶은 분</li>
        <li>짧은 기간 안에 수익 보장이 꼭 필요한 분</li>
      </ul>
    </div>
  </div>
</section>

<!-- 3. 무엇을 다루나요 -->
<section class="lg-wrap lg-sec">
  <div class="lg-sec-h"><div><p class="lg-kicker">What you get</p><h2 class="lg-h2">무엇을 다루나요</h2><p class="lg-muted">사주 지식의 양보다, 실제로 어떻게 시작하고 무엇을 팔고 어떻게 고객을 모으는지에 집중해요.</p></div></div>
  <div class="lg-cover">
    <div class="lg-cover-col">
      <h3>🙋 1:1 피드백 과정 <small>6개월 · 평생</small></h3>
      <p class="lg-muted">하는 방법에서 끝나지 않고, 실제로 고객을 모아 부업을 굴리는 데까지 같이 가요.</p>
      <ol class="lg-feat">
        <li><b>사주·타로 AI 사용법</b><span>생년월일시와 카드만으로 상담 문장까지</span></li>
        <li><b>상담 세팅</b><span>신청받는 곳, 첫 메시지, 금액 안내까지 준비</span></li>
        <li><b>상품 만들기</b><span>무엇을 얼마에 팔지, 상품을 나누고 단가를 잡는 순서</span></li>
        <li><b>홍보 · 스레드 고객 모집</b><span>어떤 글로 사람을 모으고 문의로 이어지게 하는지</span></li>
        <li><b>스레드 콘텐츠 · 자동화 프로그램</b><span>매일 올릴 글 만들기와 자동화 프로그램 사용법</span></li>
        <li><b>실제 운영 피드백</b><span>올린 글, 상담 문구, 세팅 화면을 보고 1:1로 고쳐요</span></li>
        <li><b>질문 · 수정 피드백</b><span>막히는 지점마다 물어보고 바로 풀어요</span></li>
        <li><b>+ AI 사주 자동화 시스템</b><span>AI를 어느 정도 쓰는 분께는 직접 만드는 방법까지</span></li>
      </ol>
    </div>
    <div class="lg-cover-col tarot">
      <h3>📖 사주·타로 전자책 <small>혼자 하기</small></h3>
      <p class="lg-muted">혼자 보고 실행할 수 있는 분을 위해, 실제 하는 방법을 순서대로 정리했어요.</p>
      <ol class="lg-feat">
        <li><b>AI로 사주 풀이하는 방법</b><span>명식 확인부터 풀이 문장까지</span></li>
        <li><b>타로 상담에 AI 쓰는 방법</b><span>뽑은 카드를 상담 문장으로 다듬기</span></li>
        <li><b>상담 답변 만드는 방법</b><span>자주 받는 질문에 답하는 흐름</span></li>
        <li><b>리포트 만드는 방법</b><span>팔 수 있는 리포트로 정리하기</span></li>
        <li><b>상품 구성 · 기본 운영</b><span>무엇을 팔지, 어떻게 굴릴지 기본기</span></li>
        <li><b>1:1 피드백은 없어요</b><span>막힐 때 같이 봐 드리는 건 피드백 과정에서만</span></li>
      </ol>
    </div>
  </div>
</section>

<!-- 4. 진행 흐름 -->
<section class="lg-wrap lg-sec">
  <div class="lg-sec-h"><div><p class="lg-kicker">How it works</p><h2 class="lg-h2">이렇게 진행돼요</h2></div></div>
  <ol class="lg-steps">
    <li><b>세팅</b><span>AI 도구, 상담 받을 곳, 스레드 프로필을 같이 맞춰요</span></li>
    <li><b>상품 만들기</b><span>무엇을 얼마에 팔지 정하고 안내 문구를 만들어요</span></li>
    <li><b>고객 모으기</b><span>스레드 글과 자동화로 매일 올리고 문의를 받아요</span></li>
    <li><b>운영하며 피드백</b><span>실제 상담을 하면서 막히는 지점마다 1:1로 고쳐 나가요</span></li>
  </ol>
</section>

<!-- 5. 과정·금액 -->
<section class="lg-wrap lg-sec" id="plans">
  <div class="lg-sec-h"><div><p class="lg-kicker">Plans</p><h2 class="lg-h2">과정과 금액</h2></div></div>
  <% if (courses.length) { %>
    <div class="lg-plans">
      <% courses.forEach(function(p){ var perks = perksOf(p); %>
        <article class="lg-plan <%= p.badge === '추천' ? 'hot' : '' %>" id="c<%= p.id %>">
          <% if (p.badge) { %><span class="lg-badge"><%= p.badge %></span><% } %>
          <% if (p.kind) { %><p class="lg-prod-kind"><%= p.kind %></p><% } %>
          <h3><%= p.title %></h3>
          <% if (p.subtitle) { %><p class="lg-plan-sub"><%= p.subtitle %></p><% } %>
          <div class="lg-plan-price">
            <% if (p.list_price) { %><s><%= p.list_price %></s><% } %>
            <b><%= p.price_text || '금액 문의' %></b>
            <% if (p.price_note) { %><small><%= p.price_note %></small><% } %>
          </div>
          <% var after = credit ? L.priceNum(p.price_text) - credit : 0; if (after > 0) { %>
            <p class="lg-lc-credit <%= hasEb ? 'mine' : '' %>">📖 <%= hasEb ? '전자책 구매하셔서' : '전자책 구매자는' %> <%= L.won(credit) %> 차감 → <b><%= L.won(after) %></b></p>
          <% } %>
          <% if (perks.length) { %>
            <ul class="lg-check-list sm"><% perks.forEach(function(k){ %><li><%= k %></li><% }); %></ul>
          <% } %>
          <div class="lg-prod-cta">
            <% if (mine.includes(p.id)) { %>
              <a href="/my" class="lg-btn primary block">🎓 수강 중 · 수강 화면 가기</a>
            <% } else { %>
              <a href="/course?pick=<%= p.id %>#apply" class="lg-btn primary block">이 과정 신청하기</a>
            <% } %>
            <% if (p.buy_url) { %><a href="<%= p.buy_url %>" target="_blank" rel="noopener" class="lg-btn block"><%= p.cta_label || '자세히 보기' %></a><% } %>
          </div>
          <% if (p.reviews) { %><a href="/reviews?p=<%= p.id %>" class="lg-more">후기 <%= p.reviews %>개 →</a><% } %>
        </article>
      <% }); %>
    </div>
    <% if (S.cash_note) { %><div class="lg-cash">💸 <b><%= S.cash_note %></b></div><% } %>
  <% } else { %>
    <div class="lg-card lg-empty"><b>다음 기수를 준비하고 있어요</b><p>아래 신청서로 연락처를 남겨 주시면 열리자마자 알려드릴게요.</p></div>
  <% } %>
</section>

<% if (ebooks.length) { %>
<!-- 5-2. 전자책 -->
<section class="lg-wrap lg-sec" id="ebook">
  <% ebooks.forEach(function(p){ var perks = perksOf(p); %>
    <div class="lg-card lg-ebook">
      <div class="lg-ebook-l">
        <p class="lg-kicker">E-book · 혼자 하기</p>
        <h2 class="lg-h2"><%= p.title %></h2>
        <% if (p.subtitle) { %><p class="lg-muted"><%= p.subtitle %></p><% } %>
        <div class="lg-plan-price">
          <% if (p.list_price) { %><s><%= p.list_price %></s><% } %>
          <b><%= p.price_text || '금액 문의' %></b>
          <% if (p.price_note) { %><small><%= p.price_note %></small><% } %>
        </div>
        <div class="lg-prod-cta">
          <% if (mine.includes(p.id)) { %>
            <a href="/my" class="lg-btn primary">📖 구매함 · 전자책 보러 가기</a>
          <% } else { %>
            <a href="/course?pick=<%= p.id %>#apply" class="lg-btn primary">전자책 신청하기</a>
          <% } %>
          <% if (p.buy_url) { %><a href="<%= p.buy_url %>" target="_blank" rel="noopener" class="lg-btn"><%= p.cta_label || '자세히 보기' %></a><% } %>
        </div>
      </div>
      <div class="lg-ebook-r">
        <% if (perks.length) { %><ul class="lg-check-list"><% perks.forEach(function(k){ %><li><%= k %></li><% }); %></ul><% } %>
        <div class="lg-ebook-vs">
          <p><b>전자책</b>은 <em>하는 방법</em>을 알려 드려요. 무엇을, 어디서, 어떤 순서로 하는지 혼자서도 따라 할 수 있게요.</p>
          <p><b>강의</b>는 여기에 더해 <em>사람을 어떻게 끌어들이는지</em>까지 하나하나 같이 잡고, 막힐 때마다 1:1로 봐 드려요.</p>
        </div>
      </div>
    </div>
  <% }); %>
</section>
<% } %>

<!-- 6. 비교 -->
<section class="lg-wrap lg-sec">
  <div class="lg-sec-h"><div><p class="lg-kicker">Compare</p><h2 class="lg-h2">한눈에 비교</h2></div></div>
  <div class="lg-card flush lg-tablewrap">
    <table class="lg-compare">
      <thead><tr><th></th><% if (eb) { %><th>전자책</th><% } %><th>1:1 피드백<br><small>6개월</small></th><th>1:1 피드백<br><small>평생</small></th></tr></thead>
      <tbody>
        <tr><td>AI 사주 풀이 · 타로 상담 · 리포트</td><% if (eb) { %><td>✓</td><% } %><td>✓</td><td>✓</td></tr>
        <tr><td>상품 구성 · 기본 운영</td><% if (eb) { %><td>✓</td><% } %><td>✓</td><td>✓</td></tr>
        <tr><td>상담 세팅 · 홍보 · 스레드 고객 모집</td><% if (eb) { %><td>—</td><% } %><td>✓</td><td>✓</td></tr>
        <tr><td>스레드 콘텐츠 · 자동화 프로그램</td><% if (eb) { %><td>—</td><% } %><td>✓</td><td>✓</td></tr>
        <tr><td>AI 사주 자동화 시스템 만들기</td><% if (eb) { %><td>—</td><% } %><td>✓</td><td>✓</td></tr>
        <tr><td>1:1 피드백</td><% if (eb) { %><td>—</td><% } %><td>6개월</td><td><b>평생</b></td></tr>
        <tr><td>모집</td><% if (eb) { %><td>언제든</td><% } %><td>매월 5명</td><td>매월 5명</td></tr>
        <tr><td>금액</td><% if (eb) { %><td><%= eb.price_text %></td><% } %><% courses.slice(0, 2).forEach(function(p){ %><td><%= p.price_text || '문의' %><% if (credit && L.priceNum(p.price_text) > credit) { %><br><small>전자책 구매자 <%= L.won(L.priceNum(p.price_text) - credit) %></small><% } %></td><% }); %></tr>
      </tbody>
    </table>
  </div>
  <p class="lg-hint">6개월은 하는 방법과 세팅을 익히고 혼자 설 수 있을 만큼 넉넉하게 잡은 기간이에요. 1:1 피드백 과정은 제대로 봐 드리려고 매월 5명만 받아요.</p>
</section>

<!-- 7. 후기 -->
<section class="lg-wrap lg-sec">
  <a href="/reviews" class="lg-builderbar">
    <span>⭐</span>
    <div><b>먼저 해 본 분들의 이야기</b><small>수익 금액은 싣지 않아요. 결과는 시작 시기·쓰는 시간·꾸준함에 따라 사람마다 달라요.</small></div>
    <em>후기 보기 →</em>
  </a>
</section>

<!-- 8. 자주 묻는 질문 -->
<section class="lg-wrap narrow lg-sec">
  <div class="lg-sec-h"><div><p class="lg-kicker">FAQ</p><h2 class="lg-h2">자주 묻는 질문</h2></div></div>
  <div class="lg-faq">
    <details><summary>사주나 타로를 하나도 몰라도 되나요?</summary><p>네. 사주 지식을 많이 쌓는 과정이 아니라, AI로 풀이와 상담을 하고 실제로 부업을 굴리는 과정이에요. 계산과 풀이는 AI와 도구가 맡고, 무엇을 팔고 어떻게 고객을 모을지에 시간을 써요.</p></details>
    <details><summary>무료 자료집, 전자책, 1:1 피드백 과정은 뭐가 다른가요?</summary><p>무료 자료집은 이런 부업이 있고 어디서, 무엇으로, 어떻게 하는지 큰 길만 보여 드려요. 전자책은 AI로 사주 풀이하고 타로 상담하고 리포트와 상품을 만드는 방법을 하나하나 정리해서, 1:1 피드백 없이 혼자 보고 실행할 수 있게 했어요. 1:1 피드백 과정은 여기에 더해 상담 세팅, 홍보, 스레드로 고객 모으기, 자동화까지 실제로 운영하면서 막히는 곳마다 같이 봐 드려요.</p></details>
    <details><summary>전자책을 먼저 사고 나중에 피드백 과정으로 넘어가도 되나요?</summary><p>네. 전자책 금액 <%= credit ? L.won(credit) : '' %>을 전액 차감해 드려요.<% courses.slice(0, 2).forEach(function(p){ if (credit && L.priceNum(p.price_text) > credit) { %> <%= p.title %>은 <%= L.won(L.priceNum(p.price_text) - credit) %>만 더 내시면 돼요.<% } }); %> 먼저 사도 손해 보지 않아요.</p></details>
    <details><summary>전자책은 어떻게 받나요?</summary><p>신청서를 남기시면 결제 방법을 안내드려요. 결제가 확인되면 마이페이지에 전자책 보기 버튼이 열리고, 계속 다시 보실 수 있어요.</p></details>
    <details><summary>6개월 과정과 평생 과정은 뭐가 다른가요?</summary><p>배우는 내용은 같아요. 6개월 과정은 혼자 설 수 있을 때까지 넉넉하게 6개월 동안 1:1 피드백을 드리고, 평생 과정은 기간 제한 없이 계속 피드백을 드려요. 평생 과정은 바이란의 다른 부업 과정도 먼저, 더 저렴하게 시작할 수 있어요.</p></details>
    <details><summary>왜 매월 5명만 받나요?</summary><p>1:1 피드백은 한 분 한 분 글과 세팅을 직접 봐 드려야 해서, 제대로 봐 드릴 수 있는 인원만 받아요. 그 달 자리가 차면 다음 달로 안내드려요.</p></details>
    <details><summary>피드백은 어떻게 받나요?</summary><p>카카오톡으로 막히는 지점마다 물어보시면 돼요. 올린 글, 상담 문구, 세팅 화면을 보내 주시면 같이 보고 고쳐 드려요. 다만 직접 해보지 않고 대신 다 해주길 바라시는 분은 받지 않아요.</p></details>
    <details><summary>결제는 어떻게 하나요?</summary><p>아래 신청서를 남겨 주시면 결제 방법을 안내드려요. <%= S.cash_note || '' %></p></details>
    <details><summary>프로그램에 추가로 드는 비용이 있나요?</summary><p>사주 프로그램 사용료는 따로 없어요. PDF 자동 제작이나 자동 발행에 외부 서비스를 쓰시면 그 비용만 본인 부담이고, 무료 방식만 쓰시면 추가 비용이 들지 않아요.</p></details>
    <details><summary>환불은 어떻게 되나요?</summary><p>수강 시작일 전날까지 말씀하시면 전액 환불해 드려요. 수강 시작일부터는 자료와 계정이 한 번에 제공되기 때문에 환불이 어려워요. 결제 전에 꼭 확인해 주세요.</p></details>
  </div>
</section>

<!-- 9. 신청서 -->
<section class="lg-wrap narrow lg-sec" id="apply">
  <div class="lg-card">
    <h2 class="lg-h2">수강 · 전자책 신청서</h2>
    <% if (sent) { %>
      <div class="lg-alert ok">신청을 받았어요! 확인하고 바로 연락드릴게요.</div>
      <a href="<%= S.consult_url %>" target="_blank" rel="noopener" class="lg-btn kakao block">카카오톡으로 먼저 말 걸기</a>
    <% } else { %>
      <p class="lg-muted">남겨 주시면 확인 후 카톡이나 문자로 결제 방법과 시작일을 안내드려요.</p>
      <form method="post" action="/course/apply">
        <input type="text" name="website" class="lg-hp" tabindex="-1" autocomplete="off" aria-hidden="true">
        <label class="lg-lb" for="cp">무엇을 신청하시나요</label>
        <select id="cp" name="product_id" class="lg-in" required>
          <% products.forEach(function(p){ %><option value="<%= p.id %>" <%= pick === p.id ? 'selected' : '' %>><%= p.title %><%= p.price_text ? ' · ' + p.price_text : '' %></option><% }); %>
          <% if (!products.length) { %><option value="">다음 기수 알림 받기</option><% } %>
        </select>
        <label class="lg-lb" for="cn">이름</label>
        <input id="cn" name="name" class="lg-in" maxlength="100" required value="<%= user ? (user.nickname || user.name) : '' %>">
        <label class="lg-lb" for="cph">연락처 (전화번호나 카톡 아이디)</label>
        <input id="cph" name="phone" class="lg-in" maxlength="40" required>
        <label class="lg-lb" for="cm">하고 싶은 말 (선택)</label>
        <textarea id="cm" name="message" class="lg-in" rows="3" maxlength="2000" placeholder="지금 상황, 궁금한 점, 현금 결제 여부 등을 편하게 적어 주세요"></textarea>
        <button class="lg-btn primary block lg" <%= products.length ? '' : 'disabled' %>>신청하기</button>
      </form>
    <% } %>
  </div>
</section>
<%- include('_bottom') %>
