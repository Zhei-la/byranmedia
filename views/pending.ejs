<%- include('partials/head') %>
<body>
<%- include('partials/nav') %>
<div class="wrap narrow" style="padding-top:50px">
  <div class="card">
    <% if (user.status === 'pending') { %>
      <div class="alert warn" style="margin-bottom:16px">승인을 기다리는 중입니다</div>
      <p style="font-size:14px;color:var(--ink-2);line-height:1.75">
        등록 신청이 접수됐습니다. 수강생 명단과 대조한 뒤 승인해 드립니다.<br>
        승인되면 바로 도구를 쓸 수 있습니다.
      </p>
    <% } else if (user.status === 'suspended') { %>
      <div class="alert err" style="margin-bottom:16px">이용이 중지된 계정입니다</div>
      <p style="font-size:14px;color:var(--ink-2);line-height:1.75">
        문의가 필요하면 아래로 연락해 주세요.
      </p>
    <% } else { %>
      <div class="alert warn" style="margin-bottom:16px">수강 기간이 끝났습니다</div>
      <p style="font-size:14px;color:var(--ink-2);line-height:1.75">
        만료일: <strong><%= user.expires_at ? new Date(user.expires_at).toLocaleDateString('ko-KR') : '-' %></strong><br>
        연장을 원하면 아래로 연락해 주세요.
      </p>
    <% } %>
    <% if (contact) { %>
      <div style="margin-top:18px;padding-top:16px;border-top:1px solid var(--line-soft);font-size:13.5px;color:var(--ink-2)">
        <%= contact %>
      </div>
    <% } %>
  </div>
</div>
<%- include('partials/foot') %>
