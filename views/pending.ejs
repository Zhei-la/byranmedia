<%- include('partials/head') %>
<body>
<%- include('partials/nav') %>
<div class="wrap narrow" style="padding-top:50px">
  <div class="card">
    <% if (user.status === 'pending') { %>
      <div class="alert warn" style="margin-bottom:16px">승인을 기다리는 중입니다</div>
      <p style="font-size:14px;color:var(--ink-2);line-height:1.75">
        카카오 계정으로 등록이 접수됐습니다. 수강생 명단과 대조한 뒤 승인해 드립니다.<br>
        승인되면 바로 도구를 쓸 수 있습니다.
      </p>
    <% } else if (user.status === 'suspended') { %>
      <div class="alert err" style="margin-bottom:16px">이용이 중지된 계정입니다</div>
      <p style="font-size:14px;color:var(--ink-2);line-height:1.75">
        문의가 필요하면 아래로 연락해 주세요.
      </p>
    <% } else { %>
      <div class="alert warn" style="margin-bottom:16px">수강 기간이 끝났습니다</div>
      <p style="font-size:14px;color:var(--ink-2);line-height:1.75">
        만료일: <strong><%= user.expires_at ? new Date(user.expires_at).toLocaleDateString('ko-KR') : '-' %></strong><br>
        연장을 원하면 아래로 연락해 주세요.
      </p>
    <% } %>
    <div style="margin-top:20px;padding-top:18px;border-top:1px solid var(--line-soft)">
      <a href="http://pf.kakao.com/_TCcBX" target="_blank" rel="noopener" class="kakao-btn">
        <svg width="17" height="16" viewBox="0 0 18 17" fill="none" aria-hidden="true">
          <path d="M9 0C4.03 0 0 3.13 0 6.99c0 2.5 1.68 4.69 4.2 5.92l-1.06 3.9c-.09.34.29.61.59.42l4.66-3.07c.2.02.4.02.61.02 4.97 0 9-3.13 9-6.99C18 3.13 13.97 0 9 0z" fill="#191600"/>
        </svg>
        카카오톡으로 문의하기
      </a>
      <% if (contact) { %>
        <p style="margin-top:12px;font-size:12.5px;color:var(--ink-3);text-align:center"><%= contact %></p>
      <% } %>
    </div>
  </div>
</div>
<%- include('partials/foot') %>
