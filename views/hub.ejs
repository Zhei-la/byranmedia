<%- include('partials/head') %>
<body>
<%- include('partials/nav') %>

<div class="wrap">

  <header class="welcome">
    <div class="welcome-date"><%= today %></div>
    <h1><%= user.name %>님, 안녕하세요</h1>
  </header>

  <% if (notices.length) { %>
    <section class="notices">
      <% notices.forEach(function(n){ %>
        <details class="notice <%= n.is_pinned ? 'pinned' : '' %>">
          <summary>
            <% if (n.is_pinned) { %><span class="tagline">중요</span><% } %>
            <span class="ntitle"><%= n.title %></span>
            <span class="ndate"><%= n.dateText %></span>
          </summary>
          <% if (n.body) { %><div class="nbody"><%= n.body %></div><% } %>
        </details>
      <% }); %>
    </section>
  <% } %>

  <% if (myCode) { %>
    <section class="refcard">
      <div class="refcard-top">
        <div>
          <p class="refcard-lbl">내 추천인 코드</p>
          <p class="refcard-sub">이 코드로 가입하면 누가 데려왔는지 기록됩니다<% if (invited > 0) { %> · 지금까지 <strong><%= invited %>명</strong><% } %></p>
        </div>
      </div>
      <div class="refcard-row">
        <code class="refcode" id="refCode"><%= myCode %></code>
        <button type="button" class="btn sm" data-copy="<%= myCode %>">코드 복사</button>
        <button type="button" class="btn sm primary" data-copy="<%= baseUrl %>/join?ref=<%= myCode %>">링크 복사</button>
      </div>
      <p class="refcard-link"><%= baseUrl %>/join?ref=<%= myCode %></p>
    </section>
  <% } %>

  <% if (count === 0) { %>
    <div class="blank">
      <strong>아직 등록된 도구가 없습니다</strong>
      <% if (user.role === 'admin') { %>관리 화면에서 도구를 추가해 주세요.<% } else { %>도구가 준비되면 여기에 나타납니다.<% } %>
    </div>
  <% } else { %>
    <section class="block">
      <div class="grid">
        <% Object.keys(groups).forEach(function(cat){ %>
          <% groups[cat].forEach(function(t){ %>
            <a href="/t/<%= t.slug %>" class="tool">
              <% if (t.admin_only) { %><span class="lock">관리자</span><% } %>
              <span class="ico"><%= t.emoji %></span>
              <h3><%= t.title %></h3>
              <% if (t.description) { %><p><%= t.description %></p><% } %>
              <span class="go">열기</span>
            </a>
          <% }); %>
        <% }); %>
      </div>
    </section>
  <% } %>

</div>

<%- include('partials/copy') %>
<%- include('partials/foot') %>
