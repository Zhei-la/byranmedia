<%- include('partials/head') %>
<body>
<div class="wrap narrow">
  <div class="auth-head">
    <img src="/img/logo.png" alt="바이란미디어" height="24" class="auth-logo">
    <h1>수강생 로그인</h1>
    <p>카카오톡으로 바로 들어올 수 있습니다.</p>
  </div>
  <div class="card">
    <% if (error) { %><div class="alert err"><%= error %></div><% } %>
    <% if (kakaoOn) { %>
      <a href="/auth/kakao" class="kakao-btn big">
        <svg width="19" height="18" viewBox="0 0 18 17" fill="none" aria-hidden="true">
          <path d="M9 0C4.03 0 0 3.13 0 6.99c0 2.5 1.68 4.69 4.2 5.92l-1.06 3.9c-.09.34.29.61.59.42l4.66-3.07c.2.02.4.02.61.02 4.97 0 9-3.13 9-6.99C18 3.13 13.97 0 9 0z" fill="#191600"/>
        </svg>
        카카오톡으로 로그인
      </a>
      <p class="kakao-note">
        처음 오셨다면 로그인하는 순간 등록이 신청됩니다.<br>
        수강생 명단과 확인한 뒤 승인해 드립니다.
      </p>
    <% } else { %>
      <div class="alert warn">카카오 로그인이 아직 준비되지 않았습니다. 아래 이메일 로그인을 이용해 주세요.</div>
      <a href="/login/email" class="btn primary block">이메일로 로그인</a>
    <% } %>
  </div>
  <div class="auth-foot"><a href="/login/email" class="quiet">관리자 로그인</a></div>
</div>
<%- include('partials/foot') %>
