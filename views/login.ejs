<%- include('partials/head') %>
<body>
<div class="wrap narrow">
  <div class="auth-head">
    <a href="/" class="auth-logo-link"><img src="/img/logo.png" alt="바이란미디어 홈으로" height="24" class="auth-logo"></a>
    <h1>회원가입</h1>
    <p>카카오톡으로 바로 시작할 수 있습니다.</p>
  </div>

  <div class="card">
    <% if (error) { %><div class="alert err"><%= error %></div><% } %>

    <% if (kakaoOn) { %>
      <% if (ref) { %>
        <div class="ref-fixed">
          <span class="ref-badge">추천인 확인됨</span>
          <p><strong><%= ref.name %></strong> 님의 추천으로 오셨습니다.</p>
          <code><%= ref.code %></code>
        </div>
        <a href="/auth/kakao?ref=<%= ref.code %><%= next ? '&next=' + encodeURIComponent(next) : '' %>" class="kakao-btn big">
          <span class="kakao-bubble" aria-hidden="true">
            <svg width="20" height="19" viewBox="0 0 18 17" fill="none">
              <path d="M9 0C4.03 0 0 3.13 0 6.99c0 2.5 1.68 4.69 4.2 5.92l-1.06 3.9c-.09.34.29.61.59.42l4.66-3.07c.2.02.4.02.61.02 4.97 0 9-3.13 9-6.99C18 3.13 13.97 0 9 0z" fill="#191600"/>
            </svg>
          </span>
          카카오톡으로 시작하기
        </a>
      <% } else { %>
        <a href="/auth/kakao<%= next ? '?next=' + encodeURIComponent(next) : '' %>" class="kakao-btn big">
          <span class="kakao-bubble" aria-hidden="true">
            <svg width="20" height="19" viewBox="0 0 18 17" fill="none">
              <path d="M9 0C4.03 0 0 3.13 0 6.99c0 2.5 1.68 4.69 4.2 5.92l-1.06 3.9c-.09.34.29.61.59.42l4.66-3.07c.2.02.4.02.61.02 4.97 0 9-3.13 9-6.99C18 3.13 13.97 0 9 0z" fill="#191600"/>
            </svg>
          </span>
          카카오톡으로 시작하기
        </a>
      <% } %>

      <div class="guide">
        <div class="guide-row">
          <span class="step">처음이신가요</span>
          <p>버튼 한 번이면 가입이 끝납니다. 비밀번호를 만들 것도 없습니다.
             가입하면 바이란 라운지의 무료 자료집과 AI 프롬프트를 바로 볼 수 있어요.</p>
        </div>
        <div class="guide-row">
          <span class="step">이미 가입하셨나요</span>
          <p>같은 버튼을 누르시면 바로 들어옵니다. 로그인과 가입이 같은 자리입니다.</p>
        </div>
        <p class="guide-note">닉네임과 이메일만 받아옵니다. 카카오 비밀번호는 저희가 알 수 없습니다.</p>
      </div>
    <% } else { %>
      <div class="alert warn">카카오 로그인이 아직 준비되지 않았습니다. 아래로 들어와 주세요.</div>
      <a href="/login/email" class="btn primary block">이메일로 로그인</a>
    <% } %>
  </div>

  <div class="auth-foot"><a href="/login/email<%= next ? '?next=' + encodeURIComponent(next) : '' %>" class="quiet">관리자 로그인</a></div>
</div>
<%- include('partials/foot') %>
