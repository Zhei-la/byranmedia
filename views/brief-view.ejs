<%- include('partials/head') %>
<body>
<%- include('partials/nav') %>
<div class="wrap">

  <a href="/brief" class="back-link">← 요청서 목록</a>

  <div class="page-h">
    <h1><%= brief.client_name || '(이름 없음)' %>
      <% if (brief.status === 'done') { %><span class="pill active">받음</span>
      <% } else { %><span class="pill pending">기다리는 중</span><% } %>
    </h1>
  </div>

  <!-- 보내는 방법 -->
  <section class="card">
    <h2 class="card-h">① 주소로 보내기</h2>
    <p class="card-sub">사장님이 폰에서 직접 채워 보내주십니다. 답이 오면 아래에 자동으로 정리됩니다.</p>
    <div class="refcard-row">
      <button type="button" class="btn primary" data-copy="<%= msg %>">인사말까지 복사</button>
      <button type="button" class="btn" data-copy="<%= link %>">주소만 복사</button>
      <a href="<%= link %>" target="_blank" rel="noopener" class="btn">미리 보기</a>
    </div>
    <p class="refcard-link"><%= link %></p>
  </section>

  <section class="card">
    <h2 class="card-h">② 글로 보내기</h2>
    <p class="card-sub">
      주소를 여는 걸 어려워하시는 분께는 질문만 보내세요.
      카카오톡으로 답을 받으시면 아래 "직접 입력"에 옮겨 적으시면 됩니다.
    </p>
    <div class="refcard-row">
      <button type="button" class="btn primary" data-copy="<%= questions %>">질문지 복사</button>
    </div>
  </section>

  <!-- 받은 내용 -->
  <% if (brief.status === 'done' && brief.data) { %>
    <section class="card">
      <h2 class="card-h">받은 내용</h2>
      <p class="card-sub">
        <%= new Date(brief.submitted_at).toLocaleString('ko-KR') %> 도착
      </p>
      <div class="refcard-row" style="margin-bottom:6px">
        <button type="button" class="btn primary" data-copy="<%= prompt %>">원고 프롬프트용으로 복사</button>
      </div>
      <p class="card-sub">복사한 내용을 GPT에 그대로 붙여넣으면 됩니다.</p>

      <dl class="brief-answers">
        <% let lastG=''; %>
        <% fields.forEach(function(f){ %>
          <% if (brief.data[f.k]) { %>
            <% if (f.g !== lastG) { lastG = f.g; %>
              <dt class="ba-g"><%= f.g %></dt>
            <% } %>
            <dt><%= f.label %></dt>
            <dd><%= brief.data[f.k] %></dd>
          <% } %>
        <% }); %>
      </dl>

      <% const missing = fields.filter(f => !brief.data[f.k]); %>
      <% if (missing.length) { %>
        <div class="brief-missing">
          <strong>비어 있는 항목 <%= missing.length %>개</strong>
          <p>아래 내용은 글에 쓰지 마세요. 필요하면 따로 여쭤보시면 됩니다.</p>
          <div class="words">
            <% missing.forEach(function(f){ %><span class="w"><%= f.label %></span><% }); %>
          </div>
        </div>
      <% } %>
    </section>
  <% } else { %>
    <div class="blank">
      <strong>아직 답이 오지 않았습니다</strong>
      위 주소를 사장님께 보내주세요. 채워서 보내주시면 여기에 나타납니다.
    </div>
  <% } %>

  <!-- 직접 입력 -->
  <details class="card fillbox">
    <summary>
      <span class="card-h" style="margin:0">직접 입력하기</span>
      <span class="card-sub" style="margin-left:8px">카카오톡으로 받은 답을 옮겨 적으실 수 있습니다</span>
    </summary>
    <form method="post" action="/brief/<%= brief.id %>/fill" class="fillform">
      <% let fg = ''; %>
      <% fields.forEach(function(f){ %>
        <% if (f.g !== fg) { fg = f.g; %>
          <h3 class="fill-g"><%= f.g %></h3>
        <% } %>
        <div class="field">
          <label class="lb" for="x-<%= f.k %>"><%= f.label %><% if (f.req) { %><span class="req">*</span><% } %></label>
          <% if (f.big) { %>
            <textarea id="x-<%= f.k %>" name="<%= f.k %>" rows="2"><%= (brief.data && brief.data[f.k]) || '' %></textarea>
          <% } else { %>
            <input type="text" id="x-<%= f.k %>" name="<%= f.k %>" value="<%= (brief.data && brief.data[f.k]) || '' %>">
          <% } %>
        </div>
      <% }); %>
      <button class="btn primary" style="margin-top:14px">저장</button>
    </form>
  </details>

  <section class="card">
    <form method="post" action="/brief/<%= brief.id %>/delete"
          onsubmit="return confirm('이 요청서를 삭제합니다. 받은 내용도 함께 지워집니다.')">
      <button class="btn sm danger">요청서 삭제</button>
    </form>
  </section>

</div>
<%- include('partials/copy') %>
<%- include('partials/foot') %>
