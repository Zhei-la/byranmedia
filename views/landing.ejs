<%- include('partials/head') %>
<body class="lp">

<nav class="lp-nav">
  <a href="/" class="lp-logo"><img src="/img/logo.png" alt="바이란미디어" height="27"></a>
  <a href="/login" class="lp-navlink">로그인</a>
</nav>

<main class="lp-main">

  <section class="hero">
    <p class="kicker">블로그는 한 번에 터지지 않습니다</p>
    <h1>Write.<br class="br-sm"> Publish. Repeat.</h1>
    <p class="lead">매일 쌓는 사람을 위한 작업실</p>
    <a href="/login" class="pill-cta">
      로그인하고 시작하기
      <span class="arw">→</span>
    </a>
  </section>

  <a href="/signup" class="bar">
    <span class="bar-tag">등록</span>
    <span class="bar-txt">수강생이라면 여기서 계정을 신청하세요</span>
    <span class="bar-arw">›</span>
  </a>

  <% if (tools.length) { %>
  <section class="preview">
    <div class="preview-h">
      <span class="lbl">도구</span>
      <a href="/login" class="more">전체 보기 →</a>
    </div>
    <ul class="tiles">
      <% tools.forEach(function(t){ %>
        <li class="tile">
          <span class="tile-ico"><%= t.emoji %></span>
          <span class="tile-name"><%= t.title %></span>
        </li>
      <% }); %>
    </ul>
  </section>
  <% } %>

  <section class="creed">
    <p class="creed-lbl">WHY WE EXIST</p>
    <h2>우리가 파는 것은<br>보장이 아닙니다</h2>
    <p class="creed-sub">느리지만 무너지지 않는 방법을 다룹니다.</p>
    <a href="/signup" class="creed-link">수강생 등록 신청 <span>→</span></a>
  </section>

</main>

<footer class="lp-foot">
  <img src="/img/logo.png" alt="" height="17" class="foot-logo">
  수강생 전용 공간입니다. 계정을 다른 사람과 공유하지 말아 주세요.
</footer>

</body>
</html>
