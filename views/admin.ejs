<%- include('partials/head') %>
<body>
<%- include('partials/nav') %>
<div class="wrap wide">
  <div class="page-h">
    <h1>관리</h1>
    <p>수강생 승인과 도구 등록을 여기서 합니다.</p>
  </div>

  <% if (notice) { %><div class="alert ok"><%= notice %></div><% } %>

  <div class="tabs">
    <a href="/admin?tab=users" class="<%= tab === 'users' ? 'on' : '' %>">수강생</a>
    <a href="/admin?tab=tools" class="<%= tab === 'tools' ? 'on' : '' %>">도구</a>
    <a href="/admin?tab=notices" class="<%= tab === 'notices' ? 'on' : '' %>">공지</a>
    <a href="/admin?tab=inquiries" class="<%= tab === 'inquiries' ? 'on' : '' %>">문의<% if (newInq > 0) { %> <span class="dot"><%= newInq %></span><% } %></a>
  </div>

<% if (tab === 'users') { %>

  <div class="stats">
    <div class="stat <%= stat.pending > 0 ? 'hi' : '' %>">
      <div class="n"><%= stat.pending %></div><div class="l">승인 대기</div>
    </div>
    <div class="stat"><div class="n"><%= stat.active %></div><div class="l">이용 중</div></div>
    <div class="stat"><div class="n"><%= stat.expired %></div><div class="l">기간 만료</div></div>
    <div class="stat"><div class="n"><%= stat.suspended %></div><div class="l">이용 중지</div></div>
  </div>

  <div class="filters">
    <a href="/admin?filter=all" class="<%= filter === 'all' ? 'on' : '' %>">전체</a>
    <a href="/admin?filter=pending" class="<%= filter === 'pending' ? 'on' : '' %>">승인 대기</a>
    <a href="/admin?filter=active" class="<%= filter === 'active' ? 'on' : '' %>">이용 중</a>
    <a href="/admin?filter=expired" class="<%= filter === 'expired' ? 'on' : '' %>">기간 만료</a>
    <a href="/admin?filter=suspended" class="<%= filter === 'suspended' ? 'on' : '' %>">이용 중지</a>
  </div>

  <div class="tablewrap">
    <table>
      <thead>
        <tr>
          <th>이름 · 연락처</th><th>이메일</th><th>과정</th>
          <th>상태</th><th>만료일</th><th>최근 접속</th><th style="width:220px">처리</th>
        </tr>
      </thead>
      <tbody>
      <% if (users.length === 0) { %>
        <tr><td colspan="7" style="text-align:center;color:var(--ink-3);padding:34px">해당하는 수강생이 없습니다.</td></tr>
      <% } %>
      <% users.forEach(function(u){ %>
        <tr>
          <td>
            <strong><%= u.name %></strong>
            <% if (u.role === 'admin') { %> <span class="pill admin">관리자</span><% } %>
            <% if (u.provider === 'kakao') { %><span class="pill kakao">카카오</span><% } %>
            <% if (u.phone) { %><div class="mini"><%= u.phone %></div><% } %>
          </td>
          <td class="mini"><%= u.email %></td>
          <td><%= u.course || '-' %></td>
          <td>
            <% if (u.status === 'pending') { %><span class="pill pending">승인 대기</span>
            <% } else if (u.status === 'suspended') { %><span class="pill suspended">중지</span>
            <% } else if (u.expired) { %><span class="pill expired">만료</span>
            <% } else { %><span class="pill active">이용 중</span><% } %>
          </td>
          <td class="mini"><%= u.expires_at ? new Date(u.expires_at).toLocaleDateString('ko-KR') : '무기한' %></td>
          <td class="mini"><%= u.last_login_at ? new Date(u.last_login_at).toLocaleDateString('ko-KR') : '-' %></td>
          <td>
            <div class="actions">
              <% if (u.status !== 'active') { %>
                <form method="post" action="/admin/users/<%= u.id %>/status" class="inline-form">
                  <input type="hidden" name="status" value="active">
                  <button class="btn sm primary"><%= u.status === 'suspended' ? '중지 해제' : '승인' %></button>
                </form>
              <% } %>
              <% if (u.status === 'active') { %>
                <form method="post" action="/admin/users/<%= u.id %>/status" class="inline-form"
                      onsubmit="return confirm('<%= u.name %> 님을 승인 대기 상태로 되돌립니다. 도구를 쓸 수 없게 되고, 다시 승인하면 바로 복구됩니다.')">
                  <input type="hidden" name="status" value="pending">
                  <button class="btn sm">승인 취소</button>
                </form>
                <form method="post" action="/admin/users/<%= u.id %>/status" class="inline-form"
                      onsubmit="return confirm('<%= u.name %> 님의 이용을 중지합니다.')">
                  <input type="hidden" name="status" value="suspended">
                  <button class="btn sm">이용 중지</button>
                </form>
              <% } %>
              <form method="post" action="/admin/users/<%= u.id %>/extend" class="inline-form">
                <input type="hidden" name="months" value="3">
                <button class="btn sm">3개월 연장</button>
              </form>
              <% if (u.role === 'admin') { %>
                <% if (u.id !== user.id) { %>
                  <form method="post" action="/admin/users/<%= u.id %>/role" class="inline-form"
                        onsubmit="return confirm('<%= u.name %> 님의 관리자 권한을 해제합니다.')">
                    <input type="hidden" name="role" value="member">
                    <button class="btn sm">관리자 해제</button>
                  </form>
                <% } %>
              <% } else { %>
                <form method="post" action="/admin/users/<%= u.id %>/role" class="inline-form"
                      onsubmit="return confirm('<%= u.name %> 님을 관리자로 지정합니다. 모든 수강생 정보와 문의를 볼 수 있게 됩니다.')">
                  <input type="hidden" name="role" value="admin">
                  <button class="btn sm">관리자로 지정</button>
                </form>
              <% } %>
            </div>

            <details class="editrow">
              <summary>자세히 수정</summary>
              <div class="box">
                <form method="post" action="/admin/users/<%= u.id %>/update">
                  <div class="field">
                    <label class="lb">수강 만료일</label>
                    <input type="date" name="expires_at" value="<%= u.expires_at ? new Date(u.expires_at).toISOString().slice(0,10) : '' %>">
                    <div class="hint">비워두면 무기한</div>
                  </div>
                  <div class="field">
                    <label class="lb">과정</label>
                    <input type="text" name="course" value="<%= u.course || '' %>">
                  </div>
                  <div class="field">
                    <label class="lb">권한</label>
                    <select name="role">
                      <option value="member" <%= u.role === 'member' ? 'selected' : '' %>>수강생</option>
                      <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>관리자</option>
                    </select>
                  </div>
                  <div class="field">
                    <label class="lb">메모</label>
                    <textarea name="memo" style="min-height:52px"><%= u.memo || '' %></textarea>
                  </div>
                  <button class="btn sm primary">저장</button>
                </form>

                <hr style="border:none;border-top:1px solid var(--line);margin:14px 0">

                <form method="post" action="/admin/users/<%= u.id %>/reset">
                  <label class="lb">임시 비밀번호로 바꾸기</label>
                  <div style="display:flex;gap:6px">
                    <input type="text" name="temp_password" placeholder="8자 이상" minlength="8" required>
                    <button class="btn sm">변경</button>
                  </div>
                  <div class="hint">바꾼 뒤 본인에게 직접 알려 주세요.</div>
                </form>

                <hr style="border:none;border-top:1px solid var(--line);margin:14px 0">

                <div class="hint" style="margin-bottom:8px">
                  계정을 지우면 기록이 모두 사라집니다. 본인이 다시 로그인하면 새 계정으로 처음부터 신청하게 됩니다.
                </div>
                <form method="post" action="/admin/users/<%= u.id %>/delete"
                      onsubmit="return confirm('<%= u.name %> 님의 계정을 완전히 삭제합니다. 되돌릴 수 없습니다.')">
                  <button class="btn sm danger">계정 삭제</button>
                </form>
              </div>
            </details>
          </td>
        </tr>
      <% }); %>
      </tbody>
    </table>
  </div>

  <% if (recent.length) { %>
    <div class="card" style="margin-top:18px">
      <h2 style="font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-3);margin-bottom:11px">최근 사용 기록</h2>
      <ul class="recent">
        <% recent.forEach(function(r){ %>
          <li>
            <span class="who"><%= r.name %></span>
            <span><%= r.tool_slug %></span>
            <span class="when"><%= new Date(r.created_at).toLocaleString('ko-KR', {month:'numeric', day:'numeric', hour:'2-digit', minute:'2-digit'}) %></span>
          </li>
        <% }); %>
      </ul>
    </div>
  <% } %>

<% } else if (tab === 'tools') { %>

  <div class="card" style="margin-bottom:16px">
    <h2 style="font-size:15px;font-weight:650;margin-bottom:14px">도구 추가</h2>
    <form method="post" action="/admin/tools/save">
      <div class="row">
        <div class="field">
          <label class="lb">주소용 이름 (slug)</label>
          <input type="text" name="slug" placeholder="blog-prompt-builder" required
                 pattern="[a-z0-9][a-z0-9-]*">
          <div class="hint">영문 소문자·숫자·하이픈만. 폴더 이름과 똑같이 적어 주세요.</div>
        </div>
        <div class="field">
          <label class="lb">이름</label>
          <input type="text" name="title" placeholder="원고 프롬프트 빌더" required>
        </div>
      </div>
      <div class="field">
        <label class="lb">설명</label>
        <input type="text" name="description" placeholder="목록 카드에 보일 한 줄 설명">
      </div>
      <div class="row">
        <div class="field">
          <label class="lb">분류</label>
          <input type="text" name="category" value="블로그 대행" placeholder="블로그 대행 / 사주 / 콘텐츠">
        </div>
        <div class="field">
          <label class="lb">아이콘 · 순서</label>
          <div style="display:flex;gap:6px">
            <input type="text" name="emoji" value="🧰" style="width:70px">
            <input type="number" name="sort_order" value="100">
          </div>
        </div>
      </div>
      <div class="field">
        <label style="font-size:13.5px"><input type="checkbox" name="is_active" checked> 목록에 보이기</label>
        &nbsp;&nbsp;
        <label style="font-size:13.5px"><input type="checkbox" name="admin_only"> 관리자만 사용</label>
      </div>
      <button class="btn primary">도구 추가</button>
    </form>
    <div class="alert warn" style="margin:16px 0 0">
      도구를 추가한 뒤 <code>protected/tools/{주소용 이름}/index.html</code> 파일을 올리고 다시 배포해야 실제로 열립니다.
    </div>
  </div>

  <div class="tablewrap">
    <table>
      <thead>
        <tr><th>아이콘</th><th>이름</th><th>주소</th><th>분류</th><th>순서</th><th>상태</th><th>처리</th></tr>
      </thead>
      <tbody>
      <% tools.forEach(function(t){ %>
        <tr>
          <td style="font-size:20px"><%= t.emoji %></td>
          <td>
            <strong><%= t.title %></strong>
            <% if (t.description) { %><div class="mini"><%= t.description %></div><% } %>
          </td>
          <td class="mini">/t/<%= t.slug %></td>
          <td><%= t.category %></td>
          <td class="mini"><%= t.sort_order %></td>
          <td>
            <% if (!t.is_active) { %><span class="pill expired">숨김</span>
            <% } else if (t.admin_only) { %><span class="pill admin">관리자만</span>
            <% } else { %><span class="pill active">공개</span><% } %>
          </td>
          <td>
            <details class="editrow">
              <summary>수정</summary>
              <div class="box">
                <form method="post" action="/admin/tools/save">
                  <input type="hidden" name="id" value="<%= t.id %>">
                  <div class="field"><label class="lb">주소용 이름</label>
                    <input type="text" name="slug" value="<%= t.slug %>" required></div>
                  <div class="field"><label class="lb">이름</label>
                    <input type="text" name="title" value="<%= t.title %>" required></div>
                  <div class="field"><label class="lb">설명</label>
                    <input type="text" name="description" value="<%= t.description || '' %>"></div>
                  <div class="row">
                    <div class="field"><label class="lb">분류</label>
                      <input type="text" name="category" value="<%= t.category %>"></div>
                    <div class="field"><label class="lb">아이콘 · 순서</label>
                      <div style="display:flex;gap:6px">
                        <input type="text" name="emoji" value="<%= t.emoji %>" style="width:70px">
                        <input type="number" name="sort_order" value="<%= t.sort_order %>">
                      </div>
                    </div>
                  </div>
                  <div class="field">
                    <label style="font-size:13.5px"><input type="checkbox" name="is_active" <%= t.is_active ? 'checked' : '' %>> 목록에 보이기</label>
                    &nbsp;&nbsp;
                    <label style="font-size:13.5px"><input type="checkbox" name="admin_only" <%= t.admin_only ? 'checked' : '' %>> 관리자만</label>
                  </div>
                  <button class="btn sm primary">저장</button>
                </form>
                <hr style="border:none;border-top:1px solid var(--line);margin:13px 0">
                <form method="post" action="/admin/tools/<%= t.id %>/delete"
                      onsubmit="return confirm('<%= t.title %> 을 목록에서 지웁니다.')">
                  <button class="btn sm danger">삭제</button>
                </form>
              </div>
            </details>
          </td>
        </tr>
      <% }); %>
      </tbody>
    </table>
  </div>

<% } else if (tab === 'notices') { %>

  <div class="card" style="margin-bottom:16px">
    <h2 style="font-size:15px;font-weight:650;margin-bottom:14px">공지 작성</h2>
    <form method="post" action="/admin/notices/save">
      <div class="field">
        <label class="lb">제목</label>
        <input type="text" name="title" placeholder="수강생 홈 화면에 보일 제목" required>
      </div>
      <div class="field">
        <label class="lb">내용</label>
        <textarea name="body" style="min-height:110px" placeholder="제목을 누르면 펼쳐지는 내용입니다. 비워두면 제목만 보입니다."></textarea>
      </div>
      <div class="field">
        <label style="font-size:13.5px"><input type="checkbox" name="is_active" checked> 홈에 보이기</label>
        &nbsp;&nbsp;
        <label style="font-size:13.5px"><input type="checkbox" name="is_pinned"> 중요 표시 (맨 위 고정)</label>
        &nbsp;&nbsp;
        <label style="font-size:13.5px"><input type="checkbox" name="is_public"> 외부 공개 (첫 화면에도 표시)</label>
      </div>
      <button class="btn primary">공지 등록</button>
    </form>
  </div>

  <div class="tablewrap">
    <table>
      <thead><tr><th>제목</th><th>등록일</th><th>상태</th><th style="width:150px">처리</th></tr></thead>
      <tbody>
      <% if (!notices.length) { %>
        <tr><td colspan="4" style="text-align:center;color:var(--ink-3);padding:34px">등록된 공지가 없습니다.</td></tr>
      <% } %>
      <% notices.forEach(function(n){ %>
        <tr>
          <td>
            <strong><%= n.title %></strong>
            <% if (n.body) { %><div class="mini"><%= n.body.length > 60 ? n.body.slice(0,60) + '…' : n.body %></div><% } %>
          </td>
          <td class="mini"><%= new Date(n.created_at).toLocaleDateString('ko-KR') %></td>
          <td>
            <% if (!n.is_active) { %><span class="pill expired">숨김</span>
            <% } else if (n.is_pinned) { %><span class="pill suspended">중요</span>
            <% } else { %><span class="pill active">게시중</span><% } %>
            <% if (n.is_public) { %> <span class="pill admin">외부공개</span><% } %>
          </td>
          <td>
            <details class="editrow">
              <summary>수정</summary>
              <div class="box">
                <form method="post" action="/admin/notices/save">
                  <input type="hidden" name="id" value="<%= n.id %>">
                  <div class="field"><label class="lb">제목</label>
                    <input type="text" name="title" value="<%= n.title %>" required></div>
                  <div class="field"><label class="lb">내용</label>
                    <textarea name="body" style="min-height:90px"><%= n.body || '' %></textarea></div>
                  <div class="field">
                    <label style="font-size:13.5px"><input type="checkbox" name="is_active" <%= n.is_active ? 'checked' : '' %>> 홈에 보이기</label>
                    &nbsp;&nbsp;
                    <label style="font-size:13.5px"><input type="checkbox" name="is_pinned" <%= n.is_pinned ? 'checked' : '' %>> 중요</label>
                    &nbsp;&nbsp;
                    <label style="font-size:13.5px"><input type="checkbox" name="is_public" <%= n.is_public ? 'checked' : '' %>> 외부 공개</label>
                  </div>
                  <button class="btn sm primary">저장</button>
                </form>
                <hr style="border:none;border-top:1px solid var(--line);margin:13px 0">
                <form method="post" action="/admin/notices/<%= n.id %>/delete"
                      onsubmit="return confirm('이 공지를 삭제합니다.')">
                  <button class="btn sm danger">삭제</button>
                </form>
              </div>
            </details>
          </td>
        </tr>
      <% }); %>
      </tbody>
    </table>
  </div>

<% } %>

<% if (tab === 'inquiries') { %>
  <div class="tablewrap">
    <table>
      <thead>
        <tr><th>보낸 사람</th><th>업체 · 관심 플랜</th><th>내용</th><th>접수일</th><th>상태</th><th style="width:170px">처리</th></tr>
      </thead>
      <tbody>
      <% if (!inquiries.length) { %>
        <tr><td colspan="6" style="text-align:center;color:var(--ink-3);padding:34px">접수된 문의가 없습니다.</td></tr>
      <% } %>
      <% inquiries.forEach(function(q){ %>
        <tr>
          <td>
            <strong><%= q.name %></strong>
            <% if (q.phone) { %><div class="mini"><%= q.phone %></div><% } %>
            <% if (q.email) { %><div class="mini"><%= q.email %></div><% } %>
          </td>
          <td>
            <%= q.business || '-' %>
            <% if (q.plan) { %><div class="mini"><%= q.plan %></div><% } %>
          </td>
          <td style="max-width:280px">
            <% if (q.message) { %>
              <div style="font-size:13px;line-height:1.6;white-space:pre-wrap"><%= q.message %></div>
            <% } else { %><span class="mini">내용 없음</span><% } %>
            <% if (q.memo) { %><div class="mini" style="margin-top:6px;color:var(--accent)">메모: <%= q.memo %></div><% } %>
          </td>
          <td class="mini"><%= new Date(q.created_at).toLocaleDateString('ko-KR', {month:'numeric', day:'numeric', hour:'2-digit', minute:'2-digit'}) %></td>
          <td>
            <% if (q.status === 'new') { %><span class="pill pending">신규</span>
            <% } else if (q.status === 'contacted') { %><span class="pill active">연락함</span>
            <% } else if (q.status === 'done') { %><span class="pill expired">완료</span>
            <% } else { %><span class="pill suspended">스팸</span><% } %>
          </td>
          <td>
            <div class="actions">
              <% if (q.status === 'new') { %>
                <form method="post" action="/admin/inquiries/<%= q.id %>/status" class="inline-form">
                  <input type="hidden" name="status" value="contacted">
                  <button class="btn sm primary">연락함</button>
                </form>
              <% } %>
              <% if (q.status !== 'done') { %>
                <form method="post" action="/admin/inquiries/<%= q.id %>/status" class="inline-form">
                  <input type="hidden" name="status" value="done">
                  <button class="btn sm">완료</button>
                </form>
              <% } %>
            </div>
            <details class="editrow">
              <summary>메모 · 삭제</summary>
              <div class="box">
                <form method="post" action="/admin/inquiries/<%= q.id %>/memo">
                  <label class="lb">메모</label>
                  <textarea name="memo" style="min-height:60px"><%= q.memo || '' %></textarea>
                  <button class="btn sm primary" style="margin-top:8px">저장</button>
                </form>
                <hr style="border:none;border-top:1px solid var(--line);margin:13px 0">
                <form method="post" action="/admin/inquiries/<%= q.id %>/status" class="inline-form">
                  <input type="hidden" name="status" value="spam">
                  <button class="btn sm">스팸으로 표시</button>
                </form>
                <form method="post" action="/admin/inquiries/<%= q.id %>/delete" class="inline-form"
                      onsubmit="return confirm('이 문의를 삭제합니다.')">
                  <button class="btn sm danger">삭제</button>
                </form>
              </div>
            </details>
          </td>
        </tr>
      <% }); %>
      </tbody>
    </table>
  </div>
<% } %>
</div>
<%- include('partials/foot') %>
