<%- include('partials/head') %>
<body>
<div class="wrap narrow">
  <div class="auth-head">
    <a href="/home" class="auth-logo-link"><img src="/img/logo.png" alt="바이란미디어 홈으로" height="24" class="auth-logo"></a>
    <h1>이메일 로그인</h1>
    <p>관리자용 로그인입니다.</p>
  </div>
  <div class="card">
    <% if (error) { %><div class="alert err"><%= error %></div><% } %>
    <form method="post" action="/login">
      <input type="hidden" name="next" value="<%= next %>">
      <div class="field">
        <label class="lb" for="email">이메일</label>
        <input type="email" id="email" name="email" value="<%= email %>" autocomplete="username" required autofocus>
      </div>
      <div class="field">
        <label class="lb" for="password">비밀번호</label>
        <input type="password" id="password" name="password" autocomplete="current-password" required>
      </div>
      <button type="submit" class="btn primary block">로그인</button>
    </form>
  </div>
  <div class="auth-foot"><a href="/login">카카오톡으로 로그인</a></div>
</div>
<%- include('partials/foot') %>
