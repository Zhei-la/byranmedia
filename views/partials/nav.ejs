<nav class="nav">
  <a href="/" class="logo"><img src="/img/logo.png" alt="바이란미디어" height="26"></a>
  <div class="links">
    <a href="/">라운지</a>
    <a href="/hub" class="<%= path === '/hub' ? 'on' : '' %>">도구</a>
    <a href="/brief" class="<%= path.startsWith('/brief') ? 'on' : '' %>">정보 요청서</a>
    <a href="/referral" class="<%= path === '/referral' ? 'on' : '' %>">추천 현황</a>
    
    <% if (user && user.role === 'admin') { %>
      <a href="/admin" class="<%= path === '/admin' || path.startsWith('/admin/users') ? 'on' : '' %>">관리</a>
      <a href="/admin/lounge">라운지 관리</a>
    <% } %>
  </div>
  <div class="me">
    <span class="hide-sm"><strong><%= user.name %></strong><% if (user.role === 'admin') { %> <span class="pill admin">관리자</span><% } %></span>
    <form method="post" action="/logout" class="inline-form">
      <button type="submit" class="linkbtn">로그아웃</button>
    </form>
  </div>
</nav>
