<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title><%= title ? title + ' · ' : '' %><%= siteName %></title>

<%
  // 카카오톡·문자에서 링크를 보낼 때 뜨는 미리보기
  const ogTitle = typeof ogT !== 'undefined' && ogT ? ogT : '바이란미디어';
  const ogDesc = typeof ogD !== 'undefined' && ogD
    ? ogD
    : '바이란 마케팅 대행. 블로그 대행에 필요한 도구와 문서를 그대로 드립니다.';
%>
<meta property="og:type" content="website">
<meta property="og:site_name" content="바이란미디어">
<meta property="og:title" content="<%= ogTitle %>">
<meta property="og:description" content="<%= ogDesc %>">
<meta property="og:image" content="<%= baseUrl %>/img/og.png?v=<%= assetVer %>">
<meta property="og:image:width" content="800">
<meta property="og:image:height" content="420">
<meta name="twitter:card" content="summary_large_image">
<meta name="description" content="<%= ogDesc %>">

<link rel="icon" type="image/png" href="/img/favicon.png">
<link rel="apple-touch-icon" href="/img/favicon.png">
<link rel="stylesheet" href="/css/app.css?v=<%= assetVer %>">
</head>
