# Railway 변수 설정에 그대로 넣으세요.

# PostgreSQL 연결 주소 (Railway가 자동으로 넣어줍니다)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# 세션 암호화 키 — 길고 무작위한 문자열로 직접 만드세요
SESSION_SECRET=여기에_길고_아무도_모르는_문자열을_넣으세요

# 운영 환경 표시 (Railway에서는 production)
NODE_ENV=production

# 사이트 이름
SITE_NAME=바이란미디어

# 승인 대기 화면에 보일 연락처
CONTACT_INFO=문의: 카카오톡 채널 @바이란미디어

# 첫 관리자 계정 (npm run setup 실행 시 한 번만 사용)
ADMIN_EMAIL=your@email.com
ADMIN_PASSWORD=여기에_8자이상_비밀번호
ADMIN_NAME=바이란

# ── 카카오 로그인 (선택) ──────────────────────────────
# 아래를 비워두면 카카오 버튼이 나타나지 않고, 이메일 로그인만 동작합니다.
# KAKAO_REST_API_KEY=카카오_개발자_화면의_REST_API_키
# KAKAO_CLIENT_SECRET=보안_탭에서_사용함으로_설정했다면_그_값
# BASE_URL=https://byranmedia.com
